{
  "name": "cochinchine-pensee",
  "type": "module",
  "version": "0.9.0",
  "private": true,
  "description": "The Cochinchine Pensée — a Vietnamese editorial essay publication in the Claremont Review of Books tradition",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "verify": "npm run build && npm run check && npm run lint && npm test",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "images": "node scripts/responsive-images.mjs",
    "astro": "astro",
    "lint": "biome check .",
    "format": "biome format --write .",
    "seo:review": "node scripts/seo-review.mjs",
    "pdf": "node scripts/reader-pdf.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.2.8",
    "lenis": "^1.3.25",
    "motion": "^12.43.0",
    "pagefind": "^1.5.2",
    "remark-parse": "11.0.0",
    "satori": "^0.29.0",
    "sharp": "0.35.4",
    "subset-font": "2.7.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
