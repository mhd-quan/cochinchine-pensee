    "@napi-rs/canvas": "1.0.8",
    "@shuding/opentype.js": "1.4.0-beta.0",
    "fontkit": "^2.0.4",
    "fontverter": "2.0.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "0.20.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=9.6.5"
  }
