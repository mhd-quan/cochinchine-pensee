---
import { SUBSTACK_EMBED_URL } from '~/lib/newsletter';

interface Props {
  eager?: boolean;
  tone?: 'light' | 'dark';
}

const { eager = false, tone = 'light' } = Astro.props;
---

<div class:list={['substack-signup', `substack-signup--${tone}`]}>
  <iframe
    src={SUBSTACK_EMBED_URL}
    title="Subscribe to The Cochinchine Pensées on Substack"
    width="480"
    height="320"
    loading={eager ? 'eager' : 'lazy'}
  ></iframe>
</div>

<style>
  .substack-signup {
    width: min(100%, 30rem);
    min-width: 0;
    overflow: hidden;
    background: #f8f6e9;
  }

  .substack-signup--light {
    outline: 1px solid rgb(0 0 0 / 10%);
    outline-offset: -1px;
  }

  .substack-signup--dark {
    outline: 1px solid rgb(255 255 255 / 12%);
    outline-offset: -1px;
  }

  iframe {
    display: block;
    width: 100%;
    height: 20rem;
    border: 0;
    background: #f8f6e9;
    color-scheme: light;
  }

  /* Leave room for the publication name and legal copy to wrap on small phones. */
  @media (max-width: 375px) {
    iframe {
      height: 25rem;
    }
  }
</style>
