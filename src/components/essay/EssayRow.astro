---
/**
 * EssayRow — one essay as a horizontal row, for the /essays archive.
 *
 * Unlike EssayCard (a grid tile), a row gives the title room to run and keeps
 * the date in a fixed left column so the eye can scan down the years.
 * The whole list sits on a constrained measure (see archive pages), CRB-style,
 * so the text column ends where the thumbnail begins instead of sprawling.
 *
 * Anatomy:  date · | · title + subtitle · | · thumbnail
 */
import type { CollectionEntry } from 'astro:content';
import { getCoverTreatment } from '~/lib/coverTreatment';
import { titleCaps } from '~/lib/titleCaps';
import { containedImageSizes, responsiveImage, responsiveSource } from '~/lib/responsiveImage';

interface Props {
  essay: CollectionEntry<'essays'>;
}

const { essay } = Astro.props;
const href = `/essays/${essay.id}`;
const hasCover = Boolean(essay.data.coverImage);
const sizes = hasCover ? containedImageSizes(essay.data.coverImage!, '(min-width: 768px) 168px, calc(100vw - 2.5rem)') : '';
const coverTreatment = getCoverTreatment(essay.id);

const day = essay.data.date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
});
const year = String(essay.data.date.getFullYear());
---

<article class="essay-row">
  <p class="essay-row__date">
    <time datetime={essay.data.date.toISOString()}>
      <span class="essay-row__day">{day}</span>
      <span class="essay-row__year">{year}</span>
    </time>
  </p>

  <div class="essay-row__body">
    <h3 class="essay-row__title">
      <a href={href}>
        {titleCaps(essay.data.title).map((segment) => (
          segment.small
            ? <span class="title-caps__small">{segment.text}</span>
            : <span>{segment.text}</span>
        ))}
      </a>
    </h3>
    {essay.data.subtitle && (
      <p class="essay-row__subtitle">{essay.data.subtitle}</p>
    )}
  </div>

  {hasCover && (
    <a href={href} class="essay-row__cover-link" aria-hidden="true" tabindex="-1">
      <figure class="essay-row__cover" data-cover-treatment={coverTreatment}>
        <picture>
          <source {...responsiveSource(essay.data.coverImage!, sizes)} />
          <img
            {...responsiveImage(essay.data.coverImage!, sizes, 400)}
            alt={essay.data.coverImageAlt ?? ''}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </figure>
    </a>
  )}
</article>

<style>
  .essay-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-2);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--rule-hair);
  }

  .essay-row__date {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .essay-row__date time {
    display: flex;
    align-items: baseline;
  }

  .essay-row__day {
    white-space: nowrap;
  }

  .essay-row__year {
    color: var(--accent-crimson);
  }

  /* Inline lockup on small screens: JUL 31 · 2026 */
  .essay-row__year::before {
    content: '·';
    margin-inline: 0.55em 0.45em;
    color: var(--ink-faint);
  }

  /* Caps and small caps, as on the EssayCard — the words' own capitals
   * stand full-height, the rest render as smaller capitals. */
  .essay-row__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-headline);
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  .essay-row__title a {
    color: var(--ink-primary);
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition:
      background-size var(--t-base),
      color var(--t-base);
  }

  .essay-row__title a:hover {
    color: var(--accent-crimson);
    background-size: 100% 1px;
  }

  .essay-row__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-body);
    line-height: 1.4;
    color: var(--ink-secondary);
    margin-top: var(--sp-2);
    max-width: 34rem;
  }

  .essay-row__cover-link {
    display: block;
    overflow: hidden;
    transition: transform var(--t-slow);
  }

  .essay-row:hover .essay-row__cover-link {
    transform: translateY(-2px);
  }

  .essay-row__cover {
    margin: 0;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: transparent;
  }

  .essay-row__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .essay-row__cover[data-cover-treatment='paper'] img {
    filter: url('#paper-to-alpha');
  }

  .essay-row__cover[data-cover-treatment='plate'] img {
    mask-image: radial-gradient(ellipse 82% 80% at center, #000 58%, transparent 100%);
  }

  :global(html[data-theme='night']) .essay-row__cover img {
    mix-blend-mode: screen;
    filter: invert(1) grayscale(1) contrast(1.05) brightness(0.82);
  }

  :global(html[data-theme='night']) .essay-row__cover[data-cover-treatment='paper'] img {
    filter: url('#paper-to-alpha') invert(1) grayscale(1) contrast(1.05) brightness(0.82);
  }

  /* Date column left, thumbnail right, title in a bounded middle column.
   * The row lives inside a ~56rem list measure, so the thumbnail sits
   * one gutter away from the text instead of a viewport away. */
  @media (min-width: 48rem) {
    .essay-row {
      grid-template-columns: 5.5rem minmax(0, 1fr) 10.5rem;
      align-items: start;
      column-gap: var(--sp-5);
      padding-block: var(--sp-6);
    }

    .essay-row__date time {
      flex-direction: column;
      gap: 0.3em;
      padding-top: 0.35em;
    }

    .essay-row__year::before {
      content: none;
      margin-inline: 0;
    }

    .essay-row__cover-link {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .essay-row__cover-link {
      transition-duration: 0.01ms;
    }
  }
</style>
