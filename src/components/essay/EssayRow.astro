---
/**
 * EssayRow — one essay as a full-width horizontal row, for the /essays archive.
 *
 * Unlike EssayCard (a grid tile), a row gives the title room to run and keeps
 * the date in a fixed left column so the eye can scan down the years.
 *
 * Anatomy:  date · | · title + subtitle · | · thumbnail
 */
import type { CollectionEntry } from 'astro:content';
import { getCoverTreatment } from '~/lib/coverTreatment';

interface Props {
  essay: CollectionEntry<'essays'>;
}

const { essay } = Astro.props;
const href = `/essays/${essay.id}`;
const hasCover = Boolean(essay.data.coverImage);
const coverTreatment = getCoverTreatment(essay.id);

const day = essay.data.date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
});
const year = String(essay.data.date.getFullYear());
---

<article class="essay-row">
  <p class="essay-row__date">
    <time datetime={essay.data.date.toISOString()}>
      <span class="essay-row__day">{day}</span>
      <span class="essay-row__year">{year}</span>
    </time>
  </p>

  <div class="essay-row__body">
    <h3 class="essay-row__title">
      <a href={href}>{essay.data.title}</a>
    </h3>
    {essay.data.subtitle && (
      <p class="essay-row__subtitle">{essay.data.subtitle}</p>
    )}
  </div>

  {hasCover && (
    <a href={href} class="essay-row__cover-link" aria-hidden="true" tabindex="-1">
      <figure class="essay-row__cover" data-cover-treatment={coverTreatment}>
        <img
          src={essay.data.coverImage}
          alt={essay.data.coverImageAlt ?? ''}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </a>
  )}
</article>

<style>
  .essay-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-2);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--rule-hair);
  }

  .essay-row__date {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .essay-row__year {
    color: var(--accent-crimson);
  }

  .essay-row__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-headline);
    letter-spacing: var(--tr-headline);
    text-wrap: balance;
  }

  .essay-row__title a {
    color: var(--ink-primary);
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition:
      background-size var(--t-base),
      color var(--t-base);
  }

  .essay-row__title a:hover {
    color: var(--accent-crimson);
    background-size: 100% 1px;
  }

  .essay-row__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-body);
    line-height: var(--lh-headline);
    color: var(--ink-secondary);
    margin-top: var(--sp-2);
    max-width: 44rem;
  }

  .essay-row__cover-link {
    display: block;
    overflow: hidden;
    transition: transform var(--t-slow);
  }

  .essay-row:hover .essay-row__cover-link {
    transform: translateY(-2px);
  }

  .essay-row__cover {
    margin: 0;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: transparent;
  }

  .essay-row__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .essay-row__cover[data-cover-treatment='paper'] img {
    filter: url('#paper-to-alpha');
  }

  .essay-row__cover[data-cover-treatment='plate'] img {
    mask-image: radial-gradient(ellipse 82% 80% at center, #000 58%, transparent 100%);
  }

  :global(html[data-theme='night']) .essay-row__cover img {
    mix-blend-mode: screen;
    filter: invert(1) grayscale(1) contrast(1.05) brightness(0.82);
  }

  :global(html[data-theme='night']) .essay-row__cover[data-cover-treatment='paper'] img {
    filter: url('#paper-to-alpha') invert(1) grayscale(1) contrast(1.05) brightness(0.82);
  }

  /* Date column left, thumbnail right, title given the middle to breathe */
  @media (min-width: 48rem) {
    .essay-row {
      grid-template-columns: 6.5rem minmax(0, 1fr) 9rem;
      align-items: start;
      column-gap: var(--sp-6);
      padding-block: var(--sp-6);
    }

    .essay-row__date {
      flex-direction: column;
      gap: 0.15em;
      padding-top: 0.35em;
    }

    .essay-row__cover-link {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .essay-row__cover-link {
      transition-duration: 0.01ms;
    }
  }
</style>
