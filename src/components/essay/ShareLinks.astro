---
import { canonicalUrl } from '~/lib/seo/publication.mjs';
import { shareTargets } from '~/lib/share.mjs';

interface Props { title: string; excerpt?: string; }
const { title } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
const targets = shareTargets(title, canonical);
const slug = new URL(canonical).pathname.split('/').at(-1);
---

<div class="reader-actions" aria-label="Chia sẻ bài viết" data-nosnippet data-pagefind-ignore>
  <span class="reader-actions__label">Chia sẻ</span>
  <ul class="reader-actions__list" role="list">
    <li>
      <button type="button" data-reader-share={targets.facebook} disabled class="reader-actions__btn" aria-label="Chia sẻ trên Facebook" title="Chia sẻ trên Facebook">
        <!-- Official Secondary Logo: vector from the editor-supplied Facebook asset pack. -->
        <svg class="reader-actions__facebook" width="20" height="20" viewBox="100 100 500 500" aria-hidden="true">
          <path fill="currentColor" d="M600 350c0-138.07-111.93-250-250-250S100 211.93 100 350c0 117.246 80.715 215.621 189.605 242.637V426.395h-51.55V350h51.55v-32.918c0-85.094 38.508-124.531 122.047-124.531 15.84 0 43.168 3.101 54.348 6.21v69.255c-5.898-.621-16.148-.934-28.883-.934-40.992 0-56.832 15.527-56.832 55.898V350h81.66l-14.027 76.395h-67.633v171.773C504.075 583.218 600 477.816 600 350" />
        </svg>
      </button>
    </li>
    <li>
      <button type="button" data-reader-share={targets.x} disabled class="reader-actions__btn" aria-label="Chia sẻ trên X" title="Chia sẻ trên X">
        <!-- Unmodified path from the official X logo pack. -->
        <svg class="reader-actions__x" width="18" height="19" viewBox="0 0 1200 1227" aria-hidden="true">
          <path d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z" fill="currentColor" />
        </svg>
      </button>
    </li>
    <li>
      <button type="button" class="reader-actions__btn" aria-label="Chép đường dẫn" title="Chép đường dẫn" data-copy-url={canonical} disabled>
        <svg class="reader-actions__copy" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M8 8h12v13H8zM4 16H3V3h12v1" />
        </svg>
        <svg class="reader-actions__check" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg>
      </button>
    </li>
    <li>
      <a href={targets.email} class="reader-actions__btn" aria-label="Gởi bài qua email" title="Gởi bài qua email" data-astro-prefetch="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 5h18v14H3zM3 5l9 8 9-8M3 19l6-6m6 0 6 6" /></svg>
      </a>
    </li>
    <li>
      <a href={`/downloads/essays/${slug}.pdf`} download={`${slug}.pdf`} class="reader-actions__btn" aria-label="Tải bản PDF để đọc hoặc in" title="Tải bản PDF để đọc hoặc in" rel="nofollow" data-astro-prefetch="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 3H5v18h14V8l-5-5Zm0 0v5h5M12 11v7m-3-3 3 3 3-3" /></svg>
      </a>
    </li>
  </ul>
  <noscript>
    <p><a href={targets.facebook} target="_blank" rel="noopener noreferrer" data-astro-prefetch="false">Facebook</a> · <a href={targets.x} target="_blank" rel="noopener noreferrer" data-astro-prefetch="false">X</a></p>
  </noscript>
  <span class="reader-actions__status sr-only" role="status" aria-live="polite"></span>
  <input class="reader-actions__fallback" aria-label="Đường dẫn bài viết để chép" type="url" value={canonical} readonly hidden />
</div>

<script>
  function initializeShareLinks() {
    document.querySelectorAll<HTMLButtonElement>('[data-reader-share]').forEach((button) => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';
      button.disabled = false;
      button.addEventListener('click', () => {
        window.open(button.dataset.readerShare!, '_blank', 'noopener,noreferrer');
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-copy-url]').forEach((button) => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';
      button.disabled = false;
      let timer: ReturnType<typeof setTimeout>;
      button.addEventListener('click', async () => {
        const root = button.closest('.reader-actions');
        const status = root?.querySelector<HTMLElement>('[role="status"]');
        const fallback = root?.querySelector<HTMLInputElement>('input');
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(button.dataset.copyUrl!);
          if (!button.isConnected) return;
          if (fallback) fallback.hidden = true;
          button.classList.add('is-copied');
          button.setAttribute('aria-label', 'Đã chép đường dẫn');
          if (status) { status.classList.add('sr-only'); status.textContent = 'Đã chép đường dẫn bài viết.'; }
          clearTimeout(timer);
          timer = setTimeout(() => {
            button.classList.remove('is-copied');
            button.setAttribute('aria-label', 'Chép đường dẫn');
            if (status) status.textContent = '';
          }, 2000);
        } catch {
          if (!button.isConnected) return;
          if (status) { status.classList.remove('sr-only'); status.textContent = 'Xin chép đường dẫn bên dưới.'; }
          if (fallback) { fallback.hidden = false; fallback.focus(); fallback.select(); }
        }
      });
    });
  }
  initializeShareLinks();
  document.addEventListener('astro:page-load', initializeShareLinks);
</script>

<style>
  .reader-actions {
    --share-interaction: var(--accent-crimson);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4) 0;
    margin-block: var(--sp-5);
    border-block: 1px solid var(--rule-hair);
  }
  .reader-actions__label {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    color: var(--ink-secondary);
  }
  .reader-actions__list { display: flex; flex-wrap: wrap; gap: var(--sp-1); list-style: none; padding: 0; margin: 0; }
  .reader-actions__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid transparent;
    color: var(--ink-secondary);
    background: transparent;
    cursor: pointer;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .reader-actions__btn:hover { color: var(--share-interaction); border-color: var(--share-interaction); }
  .reader-actions__btn:focus-visible { outline: 2px solid var(--share-interaction); outline-offset: var(--focus-offset); }
  .reader-actions__btn:disabled { opacity: 0.4; cursor: default; }
  .reader-actions__facebook, .reader-actions__x { color: #000; }
  :global(html[data-theme='night']) .reader-actions { --share-interaction: var(--accent-on-dark); }
  :global(html[data-theme='night']) .reader-actions__facebook,
  :global(html[data-theme='night']) .reader-actions__x { color: #fff; }
  .reader-actions__check, .is-copied .reader-actions__copy { display: none; }
  .is-copied .reader-actions__check { display: block; }
  .is-copied { color: var(--share-interaction); }
  .reader-actions__fallback { width: 100%; min-width: 0; padding: var(--sp-3); font-size: 1rem; background: var(--bg-page); color: var(--ink-primary); border: 1px solid var(--rule-strong); }
  .reader-actions__fallback[hidden] { display: none; }
  .reader-actions__status:not(.sr-only) { width: 100%; font-family: var(--font-serif); font-size: var(--fs-meta); }
</style>
