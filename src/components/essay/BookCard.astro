---
/**
 * BookCard — used on homepage "Recent Books" section and /books/ archive.
 * Clicking thumbnail or card → goes to the review essay.
 *
 * Anatomy:
 *   - Cover image (3:4 portrait, blended to page tone)
 *   - Title (serif italic — like a real book cover title)
 *   - Author (sans uppercase, like a publishing imprint)
 *   - Optional blurb (italic dek)
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
---

<a href={`/essays/${book.data.reviewEssayId}`} class="book-card">
  <figure class="book-card__cover">
    <img
      src={book.data.coverImage}
      alt={book.data.coverImageAlt ?? `${book.data.title} by ${book.data.author}`}
      loading="lazy"
      decoding="async"
    />
    <div class="book-card__spine" aria-hidden="true"></div>
  </figure>

  <div class="book-card__meta">
    <h4 class="book-card__title">{book.data.title}</h4>
    <p class="book-card__author">{book.data.author}</p>
    {book.data.blurb && <p class="book-card__blurb">{book.data.blurb}</p>}
    <span class="book-card__cta">Read review →</span>
  </div>
</a>

<style>
  .book-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--rule-hair);
    height: 100%;
    color: var(--ink-primary);
    transition: transform var(--t-slow);
  }

  .book-card:hover {
    transform: translateY(-2px);
  }

  .book-card__cover {
    margin: 0;
    position: relative;
    overflow: hidden;
    background: var(--bg-page-deep);
    aspect-ratio: 3 / 4;
    box-shadow:
      2px 3px 6px rgba(15, 15, 15, 0.08),
      -1px 0 0 rgba(255, 255, 255, 0.5) inset;
  }

  /* Spine — left edge highlight, like a real bound book */
  .book-card__spine {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.18) 0%,
      rgba(0, 0, 0, 0.05) 50%,
      rgba(0, 0, 0, 0.12) 100%
    );
    pointer-events: none;
  }

  .book-card__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    filter: contrast(0.92) saturate(0.85) brightness(1.02);
    transition: opacity var(--t-slow);
  }

  .book-card:hover .book-card__cover img {
    opacity: 0.96;
  }

  .book-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    flex-grow: 1;
  }

  .book-card__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--w-bold);
    font-size: var(--fs-h3);
    line-height: var(--lh-headline);
    color: var(--ink-primary);
    transition: color var(--t-base);
  }

  .book-card:hover .book-card__title {
    color: var(--accent-crimson);
  }

  .book-card__author {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .book-card__blurb {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    color: var(--ink-secondary);
    flex-grow: 1;
  }

  .book-card__cta {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-top: auto;
  }

  .book-card:hover .book-card__cta {
    color: var(--ink-primary);
  }
</style>
