---
/**
 * BookCard — a single reviewed book. Clicking anywhere opens the review essay.
 *
 * Covers are treated like physical objects on a shelf: every jacket keeps its
 * own aspect ratio (no cropping, no forced frame), all of them standing on a
 * shared baseline rule. The slot height is uniform; width follows the book.
 *
 * Anatomy:
 *   - Shelf slot (fixed height) → jacket (natural ratio, spine + shadow)
 *   - Title (serif italic, like a real book cover)
 *   - Author (sans uppercase, like a publishing imprint)
 *
 * Where no cover art has been supplied yet, a typographic stand-in carries
 * the title and author rather than leaving a broken <img>.
 */
import type { CollectionEntry } from 'astro:content';
import { responsiveImage } from '~/lib/responsiveImage';

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const cover = book.data.coverImage?.trim();
const hasCover = Boolean(cover);
---

<a href={`/essays/${book.data.reviewEssayId}`} class="book-card">
  <figure class="book-card__cover">
    {hasCover ? (
      <span class="book-card__jacket">
        <img
          {...responsiveImage(cover!, '(min-width: 768px) 220px, 45vw', 400)}
          alt={book.data.coverImageAlt ?? `Bìa sách ${book.data.title}`}
          loading="lazy"
          decoding="async"
        />
        <span class="book-card__spine" aria-hidden="true"></span>
      </span>
    ) : (
      <span class="book-card__jacket book-card__jacket--placeholder">
        <span class="book-card__placeholder" aria-hidden="true">
          <span class="book-card__placeholder-title">{book.data.title}</span>
          <span class="book-card__placeholder-rule"></span>
          <span class="book-card__placeholder-author">{book.data.author}</span>
        </span>
        <span class="book-card__spine" aria-hidden="true"></span>
      </span>
    )}
  </figure>

  <div class="book-card__meta">
    <h4 class="book-card__title">{book.data.title}</h4>
    <p class="book-card__author">{book.data.author}</p>
    {book.data.blurb && <p class="book-card__blurb">{book.data.blurb}</p>}
    <span class="book-card__cta">Read review →</span>
  </div>
</a>

<style>
  .book-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--rule-hair);
    height: 100%;
    color: var(--ink-primary);
  }

  /* The shelf — uniform height, books stand on the bottom rule */
  .book-card__cover {
    margin: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: clamp(11.5rem, 9.5rem + 7vw, 15rem);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--rule-hair);
  }

  .book-card__jacket {
    position: relative;
    display: inline-flex;
    max-width: 100%;
    max-height: 100%;
    box-shadow:
      0 1px 2px rgb(15 15 15 / 10%),
      2px 4px 12px rgb(15 15 15 / 12%);
    transition: transform var(--t-slow), box-shadow var(--t-slow);
  }

  .book-card:hover .book-card__jacket {
    transform: translateY(-3px);
    box-shadow:
      0 2px 3px rgb(15 15 15 / 10%),
      3px 8px 18px rgb(15 15 15 / 14%);
  }

  .book-card__jacket img {
    display: block;
    max-height: calc(clamp(11.5rem, 9.5rem + 7vw, 15rem) - var(--sp-2));
    max-width: 100%;
    width: auto;
    height: auto;
    mix-blend-mode: multiply;
    filter: contrast(0.96) saturate(0.9);
  }

  /* Night: multiply would sink jackets into the dark page — show them plainly */
  :global(html[data-theme='night']) .book-card__jacket img {
    mix-blend-mode: normal;
    filter: brightness(0.85) contrast(1.02) saturate(0.9);
  }

  /* Spine — left edge shading, like a real bound book */
  .book-card__spine {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 18%) 0%,
      rgb(0 0 0 / 5%) 50%,
      rgb(0 0 0 / 12%) 100%
    );
    pointer-events: none;
  }

  /* Typographic stand-in until real cover art is supplied */
  .book-card__jacket--placeholder {
    aspect-ratio: 3 / 4;
    height: calc(clamp(11.5rem, 9.5rem + 7vw, 15rem) - var(--sp-2));
  }

  .book-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    text-align: center;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 28%), rgb(0 0 0 / 4%)),
      var(--bg-page-deep);
  }

  .book-card__placeholder-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-meta);
    line-height: 1.25;
    color: var(--ink-secondary);
    text-wrap: balance;
  }

  .book-card__placeholder-rule {
    width: 1.75rem;
    height: 1px;
    background: var(--ink-muted);
    opacity: 0.5;
  }

  .book-card__placeholder-author {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .book-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    flex-grow: 1;
  }

  .book-card__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--w-bold);
    font-size: var(--fs-h3);
    line-height: var(--lh-headline);
    color: var(--ink-primary);
    transition: color var(--t-base);
  }

  .book-card:hover .book-card__title {
    color: var(--accent-crimson);
  }

  .book-card__author {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .book-card__blurb {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    color: var(--ink-secondary);
    flex-grow: 1;
  }

  .book-card__cta {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-top: auto;
  }

  .book-card:hover .book-card__cta {
    color: var(--ink-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .book-card__jacket {
      transition-duration: 0.01ms;
    }
  }
</style>
