---
/**
 * BookCard — a single reviewed book. Clicking anywhere opens the review essay.
 *
 * Anatomy:
 *   - Cover image (3:4 portrait, blended to page tone). Where no cover art has
 *     been supplied yet, a typographic stand-in carries the title and author
 *     rather than leaving a broken <img>.
 *   - Title (serif italic, like a real book cover)
 *   - Author (sans uppercase, like a publishing imprint)
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const cover = book.data.coverImage?.trim();
const hasCover = Boolean(cover);
---

<a href={`/essays/${book.data.reviewEssayId}`} class="book-card">
  <figure class="book-card__cover">
    {hasCover ? (
      <img
        src={cover}
        alt={book.data.coverImageAlt ?? `Bìa sách ${book.data.title}`}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="book-card__placeholder" aria-hidden="true">
        <span class="book-card__placeholder-title">{book.data.title}</span>
        <span class="book-card__placeholder-rule"></span>
        <span class="book-card__placeholder-author">{book.data.author}</span>
      </div>
    )}
    <div class="book-card__spine" aria-hidden="true"></div>
  </figure>

  <div class="book-card__meta">
    <h4 class="book-card__title">{book.data.title}</h4>
    <p class="book-card__author">{book.data.author}</p>
    {book.data.blurb && <p class="book-card__blurb">{book.data.blurb}</p>}
    <span class="book-card__cta">Read review →</span>
  </div>
</a>

<style>
  .book-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--rule-hair);
    height: 100%;
    color: var(--ink-primary);
    transition: transform var(--t-slow);
  }

  .book-card:hover {
    transform: translateY(-2px);
  }

  .book-card__cover {
    margin: 0;
    position: relative;
    overflow: hidden;
    background: var(--bg-page-deep);
    aspect-ratio: 3 / 4;
    box-shadow:
      2px 3px 6px rgba(15, 15, 15, 0.08),
      -1px 0 0 rgba(255, 255, 255, 0.5) inset;
  }

  /* Spine — left edge highlight, like a real bound book */
  .book-card__spine {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.18) 0%,
      rgba(0, 0, 0, 0.05) 50%,
      rgba(0, 0, 0, 0.12) 100%
    );
    pointer-events: none;
  }

  /* Typographic stand-in until real cover art is supplied */
  .book-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    text-align: center;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.28), rgba(0, 0, 0, 0.04)),
      var(--bg-page-deep);
  }

  .book-card__placeholder-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-meta);
    line-height: 1.25;
    color: var(--ink-secondary);
    text-wrap: balance;
  }

  .book-card__placeholder-rule {
    width: 1.75rem;
    height: 1px;
    background: var(--ink-muted);
    opacity: 0.5;
  }

  .book-card__placeholder-author {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .book-card__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    filter: contrast(0.92) saturate(0.85) brightness(1.02);
    transition: opacity var(--t-slow);
  }

  .book-card:hover .book-card__cover img {
    opacity: 0.96;
  }

  .book-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    flex-grow: 1;
  }

  .book-card__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--w-bold);
    font-size: var(--fs-h3);
    line-height: var(--lh-headline);
    color: var(--ink-primary);
    transition: color var(--t-base);
  }

  .book-card:hover .book-card__title {
    color: var(--accent-crimson);
  }

  .book-card__author {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .book-card__blurb {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    color: var(--ink-secondary);
    flex-grow: 1;
  }

  .book-card__cta {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-top: auto;
  }

  .book-card:hover .book-card__cta {
    color: var(--ink-primary);
  }
</style>
