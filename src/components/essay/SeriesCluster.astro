---
/**
 * SeriesCluster — the trio of essays making up one series, shown on the homepage.
 *
 * Anatomy:
 *   - Series name (Vietnamese, with English beneath where they differ)
 *   - Up to 3 essay cards inline
 *   - "Browse all →" link to /series/<slug>
 *
 * No preface line: a series is named, not introduced.
 */
import type { CollectionEntry } from 'astro:content';
import EssayCard from '~/components/essay/EssayCard.astro';

interface Props {
  series: CollectionEntry<'series'>;
  essays: CollectionEntry<'essays'>[];
}

const { series, essays } = Astro.props;
const trio = essays.slice(0, 3);
---

<section class="series-cluster">
  <header class="series-cluster__header">
    <p class="series-cluster__eyebrow">Series</p>
    <h3 class="series-cluster__name">{series.data.nameVi ?? series.data.name}</h3>
    <a href={`/series/${series.data.slug}`} class="series-cluster__more">
      Browse all essays →
    </a>
  </header>

  <ul class="series-cluster__trio">
    {trio.map((essay) => (
      <li>
        <EssayCard essay={essay} />
      </li>
    ))}
  </ul>
</section>

<style>
  .series-cluster {
    padding-block: var(--sp-10);
    border-top: 2px solid var(--ink-primary);
  }

  .series-cluster__header {
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--rule-hair);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
    align-items: baseline;
  }

  @media (min-width: 768px) {
    .series-cluster__header {
      grid-template-columns: auto 1fr auto;
      gap: var(--sp-5);
    }
  }

  .series-cluster__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
  }

  .series-cluster__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink-primary);
  }

  .series-cluster__more {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    border-bottom: 1px solid var(--accent-crimson);
    padding-bottom: 2px;
    transition: color var(--t-base),
                border-color var(--t-base);
    white-space: nowrap;
  }

  .series-cluster__more:hover {
    color: var(--ink-primary);
    border-bottom-color: var(--ink-primary);
  }

  .series-cluster__trio {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--sp-6);
    row-gap: 0;
  }

  @media (min-width: 768px) {
    .series-cluster__trio {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
