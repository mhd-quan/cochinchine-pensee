---
interface Props {
  author: string;
  title: string;
  essays: { url: string; title: string; date: Date }[];
}

const { author, title, essays } = Astro.props;
const letterHref = `mailto:letters@cochinchinepensees.studio?subject=${encodeURIComponent(`Thư bạn đọc: ${title}`)}`;
const dateFormat = new Intl.DateTimeFormat('vi-VN', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---

<aside class="reader-companion" aria-label="Cùng tác giả và thư bạn đọc" data-pagefind-ignore>
  {essays.length > 0 && (
    <section class="reader-companion__section" aria-labelledby="more-by-author">
      <h2 id="more-by-author">Cùng tác giả</h2>
      <p class="reader-companion__author">{author}</p>
      <ul class="reader-companion__essays" role="list">
        {essays.map((essay) => (
          <li>
            <h3><a href={essay.url} data-astro-prefetch="false">{essay.title}</a></h3>
            <time datetime={essay.date.toISOString()}>{dateFormat.format(essay.date)}</time>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="reader-companion__section reader-companion__letters" aria-labelledby="letters-heading">
    <h2 id="letters-heading">Thư gửi toà soạn</h2>
    <p>Một bài viết còn tiếp tục trong những trao đổi với bạn đọc. Chúng tôi đón nhận ý kiến, phản biện và những câu hỏi mà bài viết gợi ra.</p>
    <a class="reader-companion__email" href={letterHref}>letters@<wbr />cochinchinepensees.studio</a>
    <p class="reader-companion__note">Xin ghi tên hoặc bút danh và bài viết quý bạn muốn trao đổi.</p>
  </section>
</aside>

<style>
  .reader-companion {
    margin-top: var(--sp-10);
    color: var(--ink-primary);
    font-family: var(--font-serif);
  }

  .reader-companion__section {
    border-top: 1px solid var(--rule-strong);
    padding-top: var(--sp-4);
  }

  .reader-companion__section + .reader-companion__section {
    margin-top: var(--sp-6);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--w-semibold);
    line-height: 1.25;
    text-wrap: balance;
  }

  .reader-companion__author {
    margin-top: var(--sp-1);
    font-size: var(--fs-meta);
    font-style: italic;
    color: var(--accent-crimson);
  }

  .reader-companion__essays {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
  }

  li + li {
    margin-top: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid color-mix(in srgb, var(--ink-primary) 16%, transparent);
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: var(--w-semibold);
    line-height: 1.3;
    text-wrap: pretty;
  }

  h3 a {
    color: var(--ink-primary);
    text-decoration: none;
  }

  a {
    transition: color var(--t-fast);
  }

  a:hover {
    color: var(--accent-crimson);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  time {
    display: block;
    margin-top: var(--sp-2);
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    line-height: var(--lh-meta);
    color: var(--ink-secondary);
  }

  .reader-companion__letters p {
    margin-top: var(--sp-3);
    font-size: var(--fs-meta);
    line-height: var(--lh-body);
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .reader-companion__email {
    display: block;
    margin-top: var(--sp-4);
    font-size: var(--fs-meta);
    line-height: var(--lh-body);
    color: var(--accent-crimson);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .reader-companion__letters .reader-companion__note {
    font-style: italic;
  }

  @media (max-width: 1099px) {
    .reader-companion__section + .reader-companion__section {
      margin-top: var(--sp-8);
    }

    h2 { font-size: var(--fs-h2); }
    h3 { font-size: var(--fs-h3); }

    .reader-companion__letters p {
      font-size: var(--fs-body);
    }

    .reader-companion__letters .reader-companion__note {
      font-size: var(--fs-meta);
    }
  }
</style>
