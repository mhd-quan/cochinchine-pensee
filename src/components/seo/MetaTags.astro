---
/**
 * MetaTags — single source for head meta, OG, Twitter card, canonical.
 * Used by BaseLayout. All defaults reasonable; callers can extend if needed.
 */
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = '/og-default.png',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://cochinchinepensees.studio');
const canonical = canonicalUrl
  ? new URL(canonicalUrl, siteUrl).toString()
  : new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="The Cochinchine Pensées" />
<meta property="og:locale" content="vi_VN" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
