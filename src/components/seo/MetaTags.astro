---
/**
 * MetaTags — single source for head meta, OG, Twitter card, canonical.
 * Used by BaseLayout. All defaults reasonable; callers can extend if needed.
 */
import { canonicalUrl as normalizeCanonical } from '~/lib/seo/publication.mjs';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageAlt?: string;
  lang?: 'vi' | 'en';
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = '/og-default.png',
  ogImageAlt,
  lang = 'vi',
  noindex = false,
  ogType = 'website',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://cochinchinepensees.studio');
const canonical = normalizeCanonical(canonicalUrl ?? Astro.url.pathname);
const ogImageUrl = new URL(ogImage, siteUrl).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
{ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
<meta property="og:site_name" content="The Cochinchine Pensées" />
<meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
