---
import SearchForm from './SearchForm.astro';
interface Props { id: string; compact?: boolean }
const { id, compact = false } = Astro.props;
---
<div id={id} class="header-search" data-header-search aria-hidden="true" inert>
  <div class="header-search__pane">
    <a href="/" class="header-search__monogram" aria-label="The Cochinchine Pensées — home">TCP</a>
    <SearchForm id={`${id}-input`} variant={compact ? 'compact' : 'header'} />
    <button type="button" class="header-search__close" aria-label="Đóng tìm kiếm" data-search-close>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 5 14 14M5 19 19 5"/></svg>
    </button>
  </div>
</div>
<style>
  .header-search {
    position: absolute;
    z-index: 2;
    inset: 0 var(--header-edge) 0 0;
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0s 180ms;
  }
  .header-search.is-open {
    visibility: visible;
    transition-delay: 0s;
  }
  .header-search__pane {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr) var(--header-edge);
    align-items: center;
    column-gap: var(--sp-5);
    height: 100%;
    background: var(--bg-page);
    transform: translateX(-100%);
    transition: transform 180ms var(--ease-panel);
  }
  .is-open .header-search__pane {
    transform: translateX(0);
    transition-duration: 240ms;
  }
  .header-search__monogram {
    align-self: stretch;
    display: grid;
    place-items: center;
    border-inline-end: 1px solid var(--rule-hair);
    color: var(--ink-primary);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: var(--w-semibold);
    letter-spacing: 0.15em;
  }
  .header-search__close {
    display: grid;
    align-self: stretch;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border-inline: 1px solid var(--rule-hair);
    color: var(--accent-crimson);
    transition: color var(--t-nav);
  }
  .header-search__close:hover {
    color: var(--ink-primary);
  }
  @media (max-width: 47.999rem) {
    .header-search {
      display: none;
    }
  }
</style>
