---
import SearchForm from './SearchForm.astro';
interface Props { id: string }
const { id } = Astro.props;
---

<publication-search lang="vi">
  <SearchForm id={id} />
  <p class="search-status" role="status" aria-live="polite"></p>
  <ol class="search-results"></ol>
  <button type="button" class="search-more" hidden>Xem thêm kết quả</button>
  <noscript><p>Bật JavaScript để tìm kiếm, hoặc <a href="/archives">xem kho bài viết</a>.</p></noscript>
</publication-search>

<script>
  import './search';
</script>

<style>
  publication-search {
    display: block;
    min-width: 0;
  }
  .search-status {
    margin-block: var(--sp-4);
    color: var(--ink-secondary);
    font-size: var(--fs-meta);
  }
  .search-status:empty {
    margin: 0;
  }
  .search-results {
    list-style: none;
  }
  .search-results :global(li) {
    border-bottom: 1px solid var(--rule-hair);
  }
  .search-results :global(a) {
    display: block;
    padding-block: var(--sp-4);
    color: var(--ink-primary);
  }
  .search-results :global(h3) {
    font-family: var(--font-display);
    font-weight: var(--w-semibold);
    font-size: var(--fs-h3);
    line-height: 1.25;
    text-wrap: pretty;
  }
  .search-results :global(a:hover h3) {
    color: var(--accent-crimson);
  }
  .search-results :global(p) {
    margin-top: var(--sp-2);
    color: var(--ink-secondary);
    font-size: var(--fs-meta);
    line-height: 1.6;
  }
  .search-results :global(mark) {
    background: var(--selection-bg);
    color: inherit;
  }
  .search-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--sp-4);
    color: var(--accent-crimson);
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  [hidden] {
    display: none;
  }
</style>
