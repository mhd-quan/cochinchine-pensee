---
/**
 * Pagination — Prev / Next for the essay archive.
 *
 * Arrow glyphs are literal angle brackets, per house preference.
 * A disabled edge renders as a span, not a dead link.
 */
interface Props {
  prevUrl?: string | undefined;
  nextUrl?: string | undefined;
  currentPage: number;
  lastPage: number;
}

const { prevUrl, nextUrl, currentPage, lastPage } = Astro.props;
---

<nav class="pagination" aria-label="Essay pages">
  {prevUrl ? (
    <a href={prevUrl} class="pagination__link" rel="prev">
      <span class="pagination__glyph" aria-hidden="true">&lt;</span>
      <span>Prev Page</span>
    </a>
  ) : (
    <span class="pagination__link is-disabled" aria-disabled="true">
      <span class="pagination__glyph" aria-hidden="true">&lt;</span>
      <span>Prev Page</span>
    </span>
  )}

  <p class="pagination__count">
    <span class="pagination__count-current">{currentPage}</span>
    <span class="pagination__count-divider" aria-hidden="true">of</span>
    <span class="pagination__count-total">{lastPage}</span>
  </p>

  {nextUrl ? (
    <a href={nextUrl} class="pagination__link" rel="next">
      <span>Next Page</span>
      <span class="pagination__glyph" aria-hidden="true">&gt;</span>
    </a>
  ) : (
    <span class="pagination__link is-disabled" aria-disabled="true">
      <span>Next Page</span>
      <span class="pagination__glyph" aria-hidden="true">&gt;</span>
    </span>
  )}
</nav>

<style>
  .pagination {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-12);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--rule-hair);
  }

  .pagination__link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sp-3);
    min-height: 2.75rem;
    padding-block: var(--sp-2);
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-crimson);
    transition:
      color var(--t-base),
      opacity var(--t-base);
  }

  .pagination__link:hover {
    color: var(--ink-primary);
  }

  .pagination__link.is-disabled {
    color: var(--ink-muted);
    opacity: 0.35;
    cursor: default;
  }

  .pagination__glyph {
    font-family: var(--font-sans);
    font-size: 1em;
    line-height: 1;
    letter-spacing: 0;
  }

  .pagination__count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-align: center;
  }

  .pagination__count-current {
    color: var(--accent-crimson);
  }

  .pagination__count-divider {
    color: var(--ink-faint);
  }

  .pagination__count-total {
    color: var(--ink-secondary);
  }
</style>
