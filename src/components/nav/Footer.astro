---
import { SUBSTACK_SUBSCRIBE_URL } from '~/lib/newsletter';

const year = new Date().getFullYear();
const footerLinks = [
  { href: '/', label: 'Latest' },
  { href: '/archives', label: 'Archives' },
  { href: '/books', label: 'Book Reviews' },
  { href: '/essays', label: 'Essays' },
  { href: '/pensees', label: 'Pensées' },
  { href: '/authors', label: 'Authors' },
  { href: '/about', label: 'About us' },
  { href: '/masthead', label: 'Masthead' },
];
---

<footer class="site-footer">
  <div class="container" data-nosnippet>
    <div class="site-footer__top">
      <nav class="site-footer__nav" aria-label="Footer">
        <ul class="site-footer__links">
          {footerLinks.map(({ href, label }) => (
            <li><a href={href} class="site-footer__link">{label}</a></li>
          ))}
        </ul>
      </nav>

      <section class="site-footer__newsletter" aria-labelledby="footer-newsletter-title">
        <h2 id="footer-newsletter-title" class="site-footer__newsletter-title" lang="vi">
          Nhận thông tin bài viết mới
        </h2>
        <a href={SUBSTACK_SUBSCRIBE_URL} class="site-footer__signup" rel="external">
          Sign up on Substack
        </a>
      </section>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__closing" data-nosnippet>
      <div class="site-footer__legal">
        <p class="site-footer__copyright">© {year} The Cochinchine Pensées</p>
        <p class="site-footer__disclaimer" lang="vi">
          Quan điểm trong mỗi bài viết thuộc về tác giả, không nhất thiết đại diện
          cho tập san hay các tác giả liên kết. Tập san không nhằm ủng hộ hay cản trở
          nghị quyết hoặc tác động đến quyết định chính trị. Xin đọc với tinh thần phản tư.
        </p>
      </div>
      <div class="site-footer__identity">
        <a href="/" class="site-footer__wordmark" aria-label="The Cochinchine Pensées — home">
          The Cochinchine Pensées
        </a>
        <p class="site-footer__rights">All essays © their respective authors.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-link-size: var(--fs-nav);
    --footer-divider-space: clamp(2rem, 5vw, 5rem);
    margin-top: var(--sp-10);
    border-top: 4px solid var(--bg-oxblood-well);
    background: var(--bg-ink-well);
    color: var(--ink-on-dark);
  }

  .site-footer__top,
  .site-footer__closing {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .site-footer .container {
    padding-inline: clamp(1.25rem, 5vw, 5rem);
  }

  .site-footer__nav {
    padding-block: var(--sp-8);
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(4, auto);
    grid-auto-flow: column;
    gap: var(--sp-3) var(--sp-5);
  }

  .site-footer__link,
  .site-footer__signup {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-sans);
    font-size: var(--footer-link-size);
    font-weight: var(--w-semibold);
    line-height: 1.5;
    letter-spacing: var(--tr-nav);
    text-transform: uppercase;
    color: var(--ink-on-dark);
    transition: color var(--t-fast), border-color var(--t-fast);
  }

  .site-footer__link {
    padding-block: var(--sp-2);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .site-footer__link:hover {
    text-decoration-line: underline;
  }

  .site-footer a:focus-visible {
    outline: 2px solid var(--ink-on-dark);
    outline-offset: 4px;
  }

  .site-footer__newsletter {
    padding-block: var(--sp-8);
    border-top: 1px solid var(--rule-on-dark);
  }

  .site-footer__newsletter-title {
    max-width: 25ch;
    margin-bottom: var(--sp-5);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.5vw, 1.5rem);
    font-weight: var(--w-regular);
    line-height: var(--lh-headline);
    text-wrap: balance;
  }

  .site-footer__signup {
    justify-content: center;
    padding: var(--sp-3) var(--sp-5);
    border: 1px solid var(--ink-on-dark);
  }

  .site-footer__signup:hover {
    color: var(--accent-on-dark);
    border-color: var(--accent-on-dark);
  }

  .site-footer__bottom {
    border-top: 1px solid var(--rule-on-dark);
  }

  .site-footer__closing {
    gap: var(--sp-8);
    padding-block: var(--sp-8);
  }

  .site-footer__copyright,
  .site-footer__edition {
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    font-weight: var(--w-semibold);
    line-height: 1.65;
    letter-spacing: var(--tr-nav);
    text-transform: uppercase;
  }

  .site-footer__disclaimer {
    max-width: 65ch;
    margin-top: var(--sp-5);
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-style: italic;
    line-height: 1.55;
    color: var(--ink-on-dark-muted);
    text-wrap: pretty;
  }

  .site-footer__wordmark {
    display: inline-block;
    max-width: none;
    margin-top: var(--sp-5);
    padding-block: var(--sp-2);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--w-semibold);
    font-variant-caps: small-caps;
    line-height: var(--lh-headline);
    color: var(--ink-on-dark);
    text-wrap: balance;
  }

  .site-footer__rights {
    margin-top: var(--sp-4);
    font-family: var(--font-serif);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    color: var(--ink-on-dark-muted);
  }

  @media (min-width: 56rem) {
    .site-footer__top,
    .site-footer__closing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__nav,
    .site-footer__newsletter {
      padding-block: var(--sp-10);
    }

    .site-footer__nav,
    .site-footer__legal {
      padding-inline-end: var(--footer-divider-space);
    }

    .site-footer__newsletter,
    .site-footer__identity {
      padding-inline-start: var(--footer-divider-space);
    }

    .site-footer__newsletter {
      border-top: 0;
      border-inline-start: 1px solid var(--rule-on-dark);
    }

    .site-footer__closing {
      gap: 0;
      padding-block: var(--sp-10);
    }

    .site-footer__identity {
      text-align: end;
    }
  }
</style>
