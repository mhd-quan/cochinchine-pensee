---
/**
 * Footer — Substack signup band, 4-column directory, and utility strip.
 *
 * Now absorbs: utility nav (about, RSS, newsletter) + the issue line that used
 * to float in the header.
 */
import SubstackSignup from '~/components/newsletter/SubstackSignup.astro';
import { SUBSTACK_SUBSCRIBE_URL } from '~/lib/newsletter';

const year = new Date().getFullYear();
const showNewsletterSignup = !Astro.url.pathname.startsWith('/subscribe');
const romanYear = (() => {
  const num = new Date().getFullYear();
  const numerals: Array<[number, string]> = [
    [1000, 'M'],
    [900, 'CM'],
    [500, 'D'],
    [400, 'CD'],
    [100, 'C'],
    [90, 'XC'],
    [50, 'L'],
    [40, 'XL'],
    [10, 'X'],
    [9, 'IX'],
    [5, 'V'],
    [4, 'IV'],
    [1, 'I'],
  ];
  let result = '';
  let n = num;
  for (const [value, letter] of numerals) {
    while (n >= value) {
      result += letter;
      n -= value;
    }
  }
  return result;
})();

const footerColumns = [
  {
    title: 'Latest',
    links: [
      { href: '/', label: 'Most recent' },
      { href: '/essays', label: 'All essays' },
      { href: '/books', label: 'Book reviews' },
      { href: '/rss.xml', label: 'Subscribe via RSS' },
    ],
  },
  {
    title: 'Browse',
    links: [
      { href: '/essays', label: 'By date' },
      { href: '/series', label: 'By series' },
      { href: '/series/dan-toc', label: 'Nationalism' },
      { href: '/series/vuon-minh', label: 'Era of Rising' },
    ],
  },
  {
    title: 'Series',
    links: [
      { href: '/series/dan-toc', label: 'Chủ nghĩa dân tộc' },
      { href: '/series/vuon-minh', label: 'Kỷ nguyên vươn mình' },
      { href: '/series/kiet-suc', label: 'Thế hệ Kiệt sức' },
      { href: '/series/tu-ban', label: 'Chủ nghĩa tư bản' },
    ],
  },
  {
    title: 'About',
    links: [
      { href: '/about', label: 'Masthead' },
      { href: '/about/principles', label: 'Editorial principles' },
      { href: '/about/contact', label: 'Contact' },
      { href: '/feed.json', label: 'JSON Feed' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    {
      showNewsletterSignup && (
        <section class="site-footer__newsletter" aria-labelledby="footer-newsletter-title">
          <div class="site-footer__newsletter-intro">
            <h2 id="footer-newsletter-title" class="site-footer__newsletter-title">
              Newsletter
            </h2>
            <p class="site-footer__newsletter-copy">
              Weekly long-form Vietnamese essays, delivered directly to your inbox.
            </p>
            <a
              href={SUBSTACK_SUBSCRIBE_URL}
              class="site-footer__link site-footer__link--more"
              rel="external"
            >
              Open on Substack →
            </a>
          </div>

          <div class="site-footer__newsletter-form">
            <SubstackSignup tone="dark" />
          </div>
        </section>
      )
    }

    <div class="site-footer__grid">
      {footerColumns.map((column) => (
        <div class="site-footer__column">
          <h4 class="site-footer__column-title">{column.title}</h4>
          <ul class="site-footer__column-list">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="site-footer__link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__issue-line">
        Vol I · {romanYear}
      </p>
      <p class="site-footer__copyright">
        © {year} The Cochinchine Pensées. All essays property of their author.
      </p>
      <p class="site-footer__colophon">
        Set in Source Serif 4 and EB Garamond. Built with Astro.
      </p>
    </div>
  </div>
</footer>

<style>
  /* Ink-well register — the dark closing band of every page.
   * A thin oxblood strip sits on top like a bound edge. */
  .site-footer {
    border-top: 4px solid var(--bg-oxblood-well);
    margin-top: var(--sp-16);
    padding-block: var(--sp-10) var(--sp-6);
    background:
      linear-gradient(180deg, var(--bg-ink-well) 0%, var(--bg-ink-well-deep) 100%);
    color: var(--ink-on-dark-muted);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }

  .site-footer__newsletter {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    margin-bottom: var(--sp-8);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule-on-dark);
  }

  .site-footer__newsletter-intro {
    align-self: center;
    max-width: 32rem;
  }

  .site-footer__newsletter-title {
    margin-bottom: var(--sp-4);
    color: var(--ink-on-dark);
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-bold);
    line-height: 1.3;
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
  }

  .site-footer__newsletter-copy {
    margin-bottom: var(--sp-4);
    color: var(--ink-on-dark-muted);
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-style: italic;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .site-footer__newsletter-form {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .site-footer__newsletter {
      grid-template-columns: minmax(14rem, 1fr) minmax(20rem, 30rem);
      align-items: center;
      gap: var(--sp-8);
    }

    .site-footer__newsletter-form {
      justify-content: flex-end;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .site-footer__column-title {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-bold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-on-dark);
    margin-bottom: var(--sp-3);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--rule-on-dark);
  }

  .site-footer__column-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .site-footer__link {
    font-family: var(--font-serif);
    font-size: var(--fs-meta);
    color: var(--ink-on-dark-muted);
    border-bottom: 1px solid transparent;
    transition:
      color var(--t-base),
      border-color var(--t-base);
    display: inline-block;
    padding-bottom: 1px;
  }

  .site-footer__link:hover {
    color: var(--ink-on-dark);
    border-bottom-color: var(--accent-on-dark);
  }

  .site-footer__link--more {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-on-dark);
  }

  .site-footer__bottom {
    margin-top: var(--sp-10);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule-on-dark);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    align-items: center;
    text-align: center;
  }

  .site-footer__issue-line {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-kicker);
    color: var(--accent-on-dark);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
  }

  .site-footer__copyright {
    font-family: var(--font-serif);
    font-size: var(--fs-meta);
    color: var(--ink-on-dark-muted);
  }

  .site-footer__colophon {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-kicker);
    color: var(--ink-on-dark-faint);
    letter-spacing: 0.04em;
  }
</style>
