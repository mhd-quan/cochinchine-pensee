---
/**
 * Header — CRB-inspired masthead and navigation.
 *
 * Desktop: centered wordmark, spacious primary-navigation tier, and a
 * right-edge menu button. Mobile: compact wordmark, no navigation strip,
 * and a top-right menu button. Both buttons open the same accessible drawer.
 */

const navItems = [
  { href: '/', label: 'Latest' },
  { href: '/essays', label: 'Essays' },
  { href: '/series', label: 'Series' },
  { href: '/books', label: 'Books' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;

function isActive(itemHref: string): boolean {
  if (itemHref === '/') return currentPath === '/';
  return currentPath.startsWith(itemHref);
}
---

<header class="site-header" data-site-header data-scroll-direction="down">
  <div class="site-header__flow" data-header-flow>
    <div class="site-header__masthead">
      <a href="/" class="site-header__wordmark-link" aria-label="The Cochinchine Pensées — home">
        <span class="site-header__wordmark">The Cochinchine Pensées</span>
      </a>

      <button
        type="button"
        class="site-header__menu-toggle site-header__menu-toggle--mobile"
        aria-controls="site-menu"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-label="Open navigation"
        data-menu-open
      >
        <span class="site-header__menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>

    <div class="site-header__nav-tier">
      <div class="site-header__nav-inner">
        <nav class="site-header__desktop-nav" aria-label="Primary">
          <ul class="site-header__nav-list">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['site-header__nav-link', { 'is-active': isActive(item.href) }]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  aria-label={item.label}
                >
                  <span class="site-header__nav-label" data-label={item.label}>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <button
          type="button"
          class="site-header__menu-toggle site-header__menu-toggle--desktop"
          aria-controls="site-menu"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-label="Open navigation"
          data-menu-open
        >
          <span class="site-header__menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <span class="site-header__sentinel" data-header-sentinel aria-hidden="true"></span>

  <div
    class="site-header__reading-bar"
    data-reading-bar
    aria-hidden="true"
    inert
  >
    <a
      href="/"
      class="site-header__wordmark-link site-header__wordmark-link--reading"
      aria-label="The Cochinchine Pensées — home"
    >
      <span class="site-header__wordmark site-header__wordmark--reading">The Cochinchine Pensées</span>
    </a>

    <button
      type="button"
      class="site-header__menu-toggle site-header__menu-toggle--reading"
      aria-controls="site-menu"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-label="Open navigation"
      data-menu-open
    >
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  <dialog id="site-menu" class="site-menu" aria-labelledby="site-menu-title" data-site-menu>
    <div class="site-menu__scrim" aria-hidden="true"></div>
    <div class="site-menu__panel" data-menu-panel>
      <div class="site-menu__header">
        <h2 id="site-menu-title" class="site-menu__brand">
          <span class="site-menu__brand-wordmark" aria-hidden="true">The Cochinchine Pensées</span>
          <span class="sr-only">Navigation</span>
        </h2>
        <button
          type="button"
          class="site-menu__close"
          aria-label="Close navigation"
          data-menu-close
        >
          <span class="site-header__menu-icon site-menu__close-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>

      <nav class="site-menu__nav" aria-label="Menu">
        <ul class="site-menu__nav-list">
          {navItems.map((item, index) => (
            <li class="site-menu__nav-item">
              <a
                href={item.href}
                class:list={['site-menu__nav-link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
                aria-label={item.label}
              >
                <span class="site-menu__nav-label" data-label={item.label}>{item.label}</span>
                <span class="site-menu__nav-index" aria-hidden="true">0{index + 1}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </dialog>
</header>

<script>
  import { navigate } from 'astro:transitions/client';

  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.initialized === 'true') return;

    const flow = header.querySelector<HTMLElement>('[data-header-flow]');
    const sentinel = header.querySelector<HTMLElement>('[data-header-sentinel]');
    const readingBar = header.querySelector<HTMLElement>('[data-reading-bar]');
    const dialog = header.querySelector<HTMLDialogElement>('[data-site-menu]');
    const scrim = header.querySelector<HTMLElement>('.site-menu__scrim');
    const panel = header.querySelector<HTMLElement>('[data-menu-panel]');
    const closeButton = header.querySelector<HTMLButtonElement>('[data-menu-close]');
    const openButtons = Array.from(
      header.querySelectorAll<HTMLButtonElement>('[data-menu-open]'),
    );

    if (
      !flow ||
      !sentinel ||
      !readingBar ||
      !dialog ||
      !scrim ||
      !panel ||
      !closeButton ||
      openButtons.length === 0
    ) return;

    header.dataset.initialized = 'true';

    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeOpener: HTMLButtonElement | null = null;
    let afterClose: (() => void) | null = null;
    let closeTimer: number | undefined;
    let isClosing = false;
    let pointerStartedOnScrim = false;
    let scrollFrame = 0;
    let previousScrollY = Math.max(0, window.scrollY);
    let accumulatedDelta = 0;
    let currentDirection: 'up' | 'down' = 'down';

    const setExpanded = (expanded: boolean) => {
      for (const button of openButtons) {
        button.setAttribute('aria-expanded', String(expanded));
        button.setAttribute('aria-label', expanded ? 'Close navigation' : 'Open navigation');
      }
    };

    const setReadingBarVisible = (visible: boolean) => {
      readingBar.classList.toggle('is-visible', visible);
      readingBar.toggleAttribute('inert', !visible);
      flow.toggleAttribute('inert', visible);

      if (visible) {
        readingBar.removeAttribute('aria-hidden');
        flow.setAttribute('aria-hidden', 'true');
      } else {
        readingBar.setAttribute('aria-hidden', 'true');
        flow.removeAttribute('aria-hidden');
      }
    };

    const setScrollDirection = (direction: 'up' | 'down') => {
      if (currentDirection === direction) return;
      currentDirection = direction;
      header.dataset.scrollDirection = direction;
    };

    const updateScrollDirection = () => {
      scrollFrame = 0;

      const nextScrollY = Math.max(0, window.scrollY);
      const delta = nextScrollY - previousScrollY;
      previousScrollY = nextScrollY;

      if (Math.abs(delta) < 1) return;
      if (Math.sign(delta) !== Math.sign(accumulatedDelta)) accumulatedDelta = 0;
      accumulatedDelta += delta;

      if (accumulatedDelta >= 12) {
        setScrollDirection('down');
        accumulatedDelta = 0;
      } else if (accumulatedDelta <= -12) {
        setScrollDirection('up');
        accumulatedDelta = 0;
      }
    };

    const scheduleScrollUpdate = () => {
      if (scrollFrame !== 0) return;
      scrollFrame = window.requestAnimationFrame(updateScrollDirection);
    };

    const sentinelObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        setReadingBarVisible(!entry.isIntersecting && window.scrollY > 0);
      },
      { threshold: 0 },
    );
    sentinelObserver.observe(sentinel);
    window.addEventListener('scroll', scheduleScrollUpdate, { passive: true, signal });

    const finishClose = (restoreFocus: boolean) => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }

      const callback = afterClose;
      afterClose = null;
      dialog.classList.remove('is-visible', 'is-closing');
      if (dialog.open) dialog.close();

      isClosing = false;
      setExpanded(false);

      if (restoreFocus && activeOpener?.isConnected) {
        activeOpener.focus({ preventScroll: true });
      }
      activeOpener = null;
      callback?.();
    };

    const closeMenu = (restoreFocus = true, onClosed?: () => void) => {
      if (!dialog.open) {
        onClosed?.();
        return;
      }

      if (isClosing) {
        if (onClosed) afterClose = onClosed;
        return;
      }

      afterClose = onClosed ?? null;
      isClosing = true;
      dialog.classList.add('is-closing');
      dialog.classList.remove('is-visible');

      if (reducedMotion.matches) {
        finishClose(restoreFocus);
        return;
      }

      const onPanelTransitionEnd = (event: TransitionEvent) => {
        if (event.target !== panel || event.propertyName !== 'transform') return;
        panel.removeEventListener('transitionend', onPanelTransitionEnd);
        finishClose(restoreFocus);
      };

      panel.addEventListener('transitionend', onPanelTransitionEnd);
      closeTimer = window.setTimeout(() => {
        panel.removeEventListener('transitionend', onPanelTransitionEnd);
        finishClose(restoreFocus);
      }, 300);
    };

    const openMenu = (event: Event) => {
      const opener = event.currentTarget;
      if (!(opener instanceof HTMLButtonElement) || dialog.open) return;

      activeOpener = opener;
      afterClose = null;
      isClosing = false;
      dialog.classList.remove('is-closing', 'is-visible');
      dialog.showModal();
      setExpanded(true);
      closeButton.focus({ preventScroll: true });

      if (reducedMotion.matches) {
        dialog.classList.add('is-visible');
        return;
      }

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (dialog.open) dialog.classList.add('is-visible');
        });
      });
    };

    for (const button of openButtons) {
      button.addEventListener('click', openMenu, { signal });
    }

    closeButton.addEventListener('click', () => closeMenu(), { signal });
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeMenu();
    }, { signal });

    scrim.addEventListener('pointerdown', () => {
      pointerStartedOnScrim = true;
    }, { signal });
    scrim.addEventListener('pointercancel', () => {
      pointerStartedOnScrim = false;
    }, { signal });
    scrim.addEventListener('pointerup', () => {
      if (pointerStartedOnScrim) closeMenu();
      pointerStartedOnScrim = false;
    }, { signal });

    for (const link of dialog.querySelectorAll<HTMLAnchorElement>('a[href]')) {
      link.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) return;

        const destination = new URL(link.href);
        if (destination.origin !== window.location.origin) return;

        event.preventDefault();
        closeMenu(false, () => {
          void navigate(`${destination.pathname}${destination.search}${destination.hash}`);
        });
      }, { signal });
    }

    document.addEventListener('astro:before-swap', () => {
      sentinelObserver.disconnect();
      if (scrollFrame !== 0) window.cancelAnimationFrame(scrollFrame);
      lifecycle.abort();
      if (dialog.open) finishClose(false);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initHeader);
  initHeader();
</script>

<style>
  .site-header {
    position: relative;
    background: var(--bg-page);
  }

  .site-header__flow {
    background: var(--bg-page);
  }

  .site-header__masthead {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 4.5rem;
    padding: var(--sp-3) var(--gutter-mobile);
    border-bottom: 1px solid var(--rule-hair);
    text-align: center;
  }

  .site-header__wordmark-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: calc(100% - 7rem);
    transform-origin: center;
    transition:
      opacity var(--t-base),
      transform var(--t-slow),
      filter var(--t-base);
  }

  .site-header__wordmark-link:hover {
    opacity: 0.82;
  }

  .site-header__wordmark {
    color: var(--ink-primary);
    font-family: var(--font-display);
    /* Sized so the nowrap masthead clears the menu button down to ~320px */
    font-size: clamp(0.8125rem, 4.2vw, 1.25rem);
    font-weight: var(--w-semibold);
    line-height: 1.05;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-header__sentinel {
    display: block;
    width: 100%;
    height: 1px;
    margin-top: -1px;
    pointer-events: none;
  }

  .site-header__reading-bar {
    position: fixed;
    z-index: var(--z-header);
    inset: 0 0 auto;
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr) 3.75rem;
    align-items: center;
    min-height: 3.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink-primary) 10%, transparent);
    background: var(--bg-page);
    box-shadow: 0 0.35rem 1.2rem rgb(15 15 15 / 4%);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, -110%, 0);
    transition:
      transform 320ms cubic-bezier(0.2, 0, 0, 1),
      opacity 180ms cubic-bezier(0.2, 0, 0, 1),
      background-color var(--t-base),
      border-color var(--t-base);
    contain: layout paint;
  }

  .site-header__reading-bar.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
    will-change: transform, opacity;
  }

  .site-header__wordmark-link--reading {
    grid-column: 2;
    max-width: 100%;
    transform: scale(0.76);
  }

  .site-header[data-scroll-direction='up'] .site-header__wordmark-link--reading {
    transform: scale(0.88);
  }

  .site-header__wordmark--reading {
    font-size: clamp(0.875rem, 3.5vw, 1.05rem);
  }

  .site-header__nav-tier {
    display: none;
  }

  .site-header__nav-inner {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 4.5rem;
    min-height: 4.5rem;
  }

  .site-header__nav-inner::before {
    content: '';
  }

  .site-header__desktop-nav {
    display: grid;
    align-items: center;
    min-width: 0;
  }

  .site-header__nav-list {
    display: grid;
    grid-template-columns: repeat(5, max-content);
    justify-content: space-between;
    justify-self: center;
    width: min(100%, 72rem);
    padding-inline: clamp(var(--sp-6), 6vw, var(--sp-16));
  }

  /* Nav links — colour shift plus a hairline that grows from the centre.
   * Compositor-friendly on purpose: no blur, no text-shadow, no repaints. */
  .site-header__nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: var(--sp-2);
    color: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    font-weight: var(--w-semibold);
    line-height: 1;
    letter-spacing: var(--tr-nav);
    text-transform: uppercase;
    user-select: none;
    transition: color var(--t-fast);
  }

  .site-header__nav-label {
    position: relative;
    display: inline-block;
    padding-bottom: 0.45em;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 50% 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size var(--t-base);
  }

  .site-header__nav-link:hover {
    color: var(--accent-crimson);
  }

  .site-header__nav-link:hover .site-header__nav-label {
    background-size: 100% 1px;
  }

  .site-header__nav-link.is-active {
    color: var(--ink-primary);
  }

  .site-header__nav-link.is-active .site-header__nav-label {
    background-image: linear-gradient(var(--accent-crimson), var(--accent-crimson));
    background-size: 100% 1px;
  }

  .site-header__menu-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--ink-primary);
    user-select: none;
    transition:
      color var(--t-base),
      transform var(--t-fast);
  }

  .site-header__menu-toggle:hover {
    color: var(--accent-crimson);
  }

  .site-header__menu-toggle:active,
  .site-menu__close:active {
    transform: scale(0.96);
  }

  .site-header__menu-toggle--mobile {
    position: absolute;
    top: 50%;
    right: var(--gutter-mobile);
    translate: 0 -50%;
  }

  .site-header__menu-toggle--desktop {
    display: none;
  }

  .site-header__menu-toggle--reading {
    grid-column: 3;
    justify-self: stretch;
    width: 3.75rem;
    height: 3.75rem;
    border-left: 1px solid color-mix(in srgb, var(--ink-primary) 10%, transparent);
  }

  .site-header__menu-icon {
    position: relative;
    display: block;
    width: 1.5rem;
    height: 1rem;
  }

  /* Hamburger morph — three bars fold into an ✕ on a small spring.
   * Transform and opacity only; the spring gives the fold its life. */
  .site-header__menu-icon span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform var(--t-spring-snap),
      opacity 140ms var(--ease-out-quart);
  }

  .site-header__menu-icon span:nth-child(1) {
    transform: translateY(-0.375rem);
  }

  .site-header__menu-icon span:nth-child(2) {
    transform: scaleX(0.72);
  }

  .site-header__menu-icon span:nth-child(3) {
    transform: translateY(0.375rem);
  }

  .site-header__menu-toggle[aria-expanded='true'] .site-header__menu-icon span:nth-child(1),
  .site-menu.is-visible .site-menu__close .site-header__menu-icon span:nth-child(1) {
    transform: rotate(45deg) scaleX(0.82);
  }

  .site-header__menu-toggle[aria-expanded='true'] .site-header__menu-icon span:nth-child(2),
  .site-menu.is-visible .site-menu__close .site-header__menu-icon span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.1);
  }

  .site-header__menu-toggle[aria-expanded='true'] .site-header__menu-icon span:nth-child(3),
  .site-menu.is-visible .site-menu__close .site-header__menu-icon span:nth-child(3) {
    transform: rotate(-45deg) scaleX(0.82);
  }

  .site-menu {
    position: fixed;
    z-index: var(--z-modal);
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
    color: var(--ink-primary);
  }

  .site-menu[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .site-menu::backdrop {
    background: transparent;
  }

  /* The scrim is invisible — the panel is part of the page, not an overlay.
   * Kept in the DOM as a click-capture target only. */
  .site-menu__scrim {
    position: fixed;
    inset: 0;
    background: transparent;
    cursor: default;
  }

  /* Panel slides in smoothly and lives as part of the page.
   * Same paper background as the page; no shadow, no texture, no overshoot. */
  .site-menu__panel {
    position: relative;
    z-index: 1;
    grid-column: 2;
    width: min(88vw, 28rem);
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-left: 1px solid color-mix(in srgb, var(--ink-primary) 10%, transparent);
    background-color: var(--bg-page);
    transform: translate3d(104%, 0, 0);
    transition: transform 280ms var(--ease-out-quart);
    contain: layout paint;
  }

  .site-menu[open] .site-menu__panel {
    will-change: transform;
  }

  .site-menu.is-visible .site-menu__panel {
    transform: translate3d(0, 0, 0);
  }

  .site-menu.is-closing .site-menu__panel {
    transition: transform 220ms var(--ease-out-quart);
  }

  .site-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    padding-inline: var(--sp-5) var(--sp-3);
    border-bottom: 1px solid var(--rule-hair);
  }

  .site-menu__brand {
    min-width: 0;
    color: var(--ink-primary);
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 0.8rem + 0.3vw, 1.05rem);
    font-weight: var(--w-semibold);
    line-height: 1.05;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .site-menu__brand-wordmark {
    white-space: nowrap;
  }

  .site-menu__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--ink-primary);
    transition:
      color var(--t-base),
      transform var(--t-fast);
  }

  .site-menu__close:hover {
    color: var(--accent-crimson);
  }

  .site-menu__nav {
    padding: var(--sp-5) var(--sp-5) var(--sp-10);
  }

  .site-menu__nav-list {
    display: grid;
    gap: var(--sp-1);
  }

  /* Items are always visible — no stagger, no transform.
   * Emphasis comes from font-weight + background fade on hover/focus. */
  .site-menu__nav-item {
    opacity: 1;
    transform: none;
  }

  .site-menu__nav-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: 3.25rem;
    padding: var(--sp-2) var(--sp-4);
    color: var(--ink-secondary);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 3vw, 1.125rem);
    font-weight: var(--w-medium);
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* Square-edged highlight — no rounded blob under the label. */
    border-radius: 0;
    transition:
      font-weight var(--t-fast),
      color var(--t-fast),
      background-color var(--t-fast);
  }

  .site-menu__nav-link:hover,
  .site-menu__nav-link:focus-visible {
    color: var(--ink-primary);
    font-weight: var(--w-bold);
    background-color: var(--bg-page-deep);
    border-radius: 0;
    outline: none;
  }

  .site-menu__nav-link.is-active {
    color: var(--ink-primary);
    font-weight: var(--w-bold);
  }

  /* No label transform — items stay put. */
