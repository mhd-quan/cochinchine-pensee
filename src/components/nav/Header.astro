---
import { SUBSTACK_SUBSCRIBE_URL } from '~/lib/newsletter';
import SearchResults from '~/components/search/SearchResults.astro';

const navItems = [
  { href: '/', label: 'Latest' },
  { href: '/essays', label: 'Essays' },
  { href: '/series', label: 'Series' },
  { href: '/books', label: 'Books' },
  { href: '/about', label: 'About' },
];
const currentPath = Astro.url.pathname;
const Wordmark = currentPath === '/' ? 'h1' : 'span';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header" data-site-header>
  <div class="site-header__flow" data-header-flow data-nosnippet>
    <div class="site-header__masthead">
      <a href="/search" class="header-control header-control--search" aria-label="Tìm kiếm" aria-haspopup="dialog" aria-controls="site-search" data-search-open>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></svg>
      </a>
      <a href="/" class="site-header__wordmark-link" aria-label="The Cochinchine Pensées — home">
        <Wordmark class="site-header__wordmark">The Cochinchine Pensées</Wordmark>
      </a>
      <button type="button" class="header-control" aria-controls="site-menu" aria-haspopup="dialog" aria-expanded="false" aria-label="Open navigation" data-menu-open>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 5h20M2 12h20M2 19h20"/></svg>
      </button>
    </div>

    <a href={SUBSTACK_SUBSCRIBE_URL} class="site-header__newsletter-banner" rel="external">
      <span class="site-header__newsletter-copy" lang="vi">Nhận thông tin bài viết mới</span>
      <span class="site-header__newsletter-action">Subscribe on Substack <span aria-hidden="true">→</span></span>
    </a>

    <nav class="site-header__desktop-nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {navItems.map((item) => (
          <li><a href={item.href} class:list={['site-header__nav-link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span class="nav-label">{item.label}</span>
          </a></li>
        ))}
      </ul>
    </nav>
  </div>
  <span class="site-header__sentinel" data-header-sentinel aria-hidden="true"></span>

  <div class="site-header__reading-bar" data-reading-bar aria-hidden="true" inert data-nosnippet>
    <a href="/search" class="header-control header-control--search" aria-label="Tìm kiếm" aria-haspopup="dialog" aria-controls="site-search" data-search-open>
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></svg>
    </a>
    <a href="/" class="site-header__wordmark-link" aria-label="The Cochinchine Pensées — home"><span class="site-header__wordmark site-header__wordmark--reading">The Cochinchine Pensées</span></a>
    <button type="button" class="header-control" aria-controls="site-menu" aria-haspopup="dialog" aria-expanded="false" aria-label="Open navigation" data-menu-open>
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 5h20M2 12h20M2 19h20"/></svg>
    </button>
  </div>

  <dialog id="site-menu" class="site-menu" aria-labelledby="site-menu-title" data-site-dialog data-nosnippet>
    <div class="site-menu__header">
      <h2 id="site-menu-title">The Cochinchine Pensées</h2>
      <button type="button" class="dialog-close" aria-label="Close navigation" data-dialog-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 5 14 14M5 19 19 5"/></svg>
      </button>
    </div>
    <nav aria-label="Menu" class="site-menu__nav">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href} class:list={['site-menu__nav-link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}><span class="nav-label">{item.label}</span></a></li>
        ))}
      </ul>
      <a href="/search" class="site-menu__search-link" data-search-open>Tìm kiếm <span aria-hidden="true">→</span></a>
    </nav>
  </dialog>

  <dialog id="site-search" class="site-search" aria-labelledby="site-search-title" data-site-dialog data-nosnippet>
    <div class="site-search__inner">
      <div class="site-search__header">
        <h2 id="site-search-title" lang="vi">Tìm kiếm</h2>
        <button type="button" class="dialog-close" aria-label="Đóng tìm kiếm" data-dialog-close>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 5 14 14M5 19 19 5"/></svg>
        </button>
      </div>
      <SearchResults id="header-search" compact />
    </div>
  </dialog>
</header>

<script>
  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.ready) return;
    header.dataset.ready = 'true';
    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const flow = header.querySelector<HTMLElement>('[data-header-flow]')!;
    const bar = header.querySelector<HTMLElement>('[data-reading-bar]')!;
    const sentinel = header.querySelector('[data-header-sentinel]')!;
    const menu = header.querySelector<HTMLDialogElement>('#site-menu')!;
    const search = header.querySelector<HTMLDialogElement>('#site-search')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let opener: HTMLElement | null = null;
    let activeDialog: HTMLDialogElement | null = null;
    let closeTimer: ReturnType<typeof setTimeout>;
    let openFrame = 0;

    // The compact bar has a stable size. No per-scroll animation or layout reads.
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry) return;
      const visible = entry.boundingClientRect.bottom <= 0;
      bar.classList.toggle('is-visible', visible);
      bar.inert = !visible;
      bar.setAttribute('aria-hidden', String(!visible));
      flow.inert = visible;
      if (visible) flow.setAttribute('aria-hidden', 'true');
      else flow.removeAttribute('aria-hidden');
    });
    observer.observe(sentinel);

    const finishClose = (restoreFocus = true) => {
      clearTimeout(closeTimer);
      cancelAnimationFrame(openFrame);
      if (!activeDialog) return;
      const closedDialog = activeDialog;
      activeDialog = null;
      closedDialog.classList.remove('is-visible');
      closedDialog.close();
      document.documentElement.classList.remove('has-site-dialog');
      for (const button of header.querySelectorAll('[data-menu-open]'))
        button.setAttribute('aria-expanded', 'false');
      if (restoreFocus && opener?.isConnected) {
        // Scrolling or a viewport resize can hide the original opener.
        const visibleOpener = opener.closest('[inert]')
          ? bar.querySelector<HTMLElement>('[data-menu-open]')
          : opener;
        visibleOpener?.focus({ preventScroll: true });
      }
      opener = null;
    };
    const close = () => {
      if (!activeDialog) return;
      activeDialog.classList.remove('is-visible');
      clearTimeout(closeTimer);
      if (reducedMotion.matches) finishClose();
      else closeTimer = setTimeout(finishClose, 180);
    };
    const open = (dialog: HTMLDialogElement, trigger: HTMLElement) => {
      const returnTo = trigger.closest('dialog') ? opener : trigger;
      finishClose(false);
      opener = returnTo;
      activeDialog = dialog;
      document.documentElement.classList.add('has-site-dialog');
      dialog.showModal();
      for (const button of header.querySelectorAll('[data-menu-open]'))
        button.setAttribute('aria-expanded', String(dialog === menu));
      const focus = dialog.querySelector<HTMLElement>(
        dialog === search ? 'input' : '[data-dialog-close]',
      );
      focus?.focus({ preventScroll: true });
      // Commit the resting position before the transition. Transitions remain interruptible.
      openFrame = requestAnimationFrame(() => {
        openFrame = requestAnimationFrame(() => {
          if (activeDialog === dialog) dialog.classList.add('is-visible');
        });
      });
    };
    for (const trigger of header.querySelectorAll<HTMLElement>(
      '[data-menu-open], [data-search-open]',
    )) {
      trigger.addEventListener(
        'click',
        (event) => {
          if (
            event instanceof MouseEvent &&
            (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          )
            return;
          event.preventDefault();
          open(trigger.hasAttribute('data-search-open') ? search : menu, trigger);
        },
        { signal },
      );
    }
    for (const dialog of [menu, search]) {
      dialog.querySelector('[data-dialog-close]')!.addEventListener('click', close, { signal });
      dialog.addEventListener(
        'cancel',
        (event) => {
          event.preventDefault();
          close();
        },
        { signal },
      );
      let onBackdrop = false;
      const outside = (event: PointerEvent) => {
        const rect = dialog.getBoundingClientRect();
        return (
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom
        );
      };
      dialog.addEventListener(
        'pointerdown',
        (event) => {
          onBackdrop = outside(event);
        },
        { signal },
      );
      dialog.addEventListener(
        'pointerup',
        (event) => {
          if (onBackdrop && outside(event)) close();
          onBackdrop = false;
        },
        { signal },
      );
      dialog.addEventListener(
        'pointercancel',
        () => {
          onBackdrop = false;
        },
        { signal },
      );
    }
    document.addEventListener(
      'astro:before-swap',
      () => {
        finishClose(false);
        observer.disconnect();
        lifecycle.abort();
      },
      { once: true, signal },
    );
  }
  document.addEventListener('astro:page-load', initHeader);
  initHeader();
</script>

<style>
  .site-header {
    position: relative;
    background: var(--bg-page);
  }
  .site-header__masthead,
  .site-header__reading-bar {
    display: grid;
    grid-template-columns: var(--header-edge) minmax(0, 1fr) var(--header-edge);
    align-items: center;
    background: var(--bg-page);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .site-header__masthead {
    --header-edge: 3rem;
    min-height: 4rem;
  }
  .header-control {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 3rem;
    color: var(--ink-primary);
    transition: color var(--t-fast);
  }
  .header-control:hover,
  .dialog-close:hover {
    color: var(--accent-crimson);
  }
  .site-header__wordmark-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 44px;
    color: var(--ink-primary);
  }
  .site-header__wordmark {
    font-family: var(--font-display);
    font-size: clamp(0.78rem, 3.4vw, 1.2rem);
    font-weight: var(--w-semibold);
    line-height: 1.2;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .site-header__newsletter-banner {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    column-gap: var(--sp-3);
    row-gap: var(--sp-1);
    min-height: 44px;
    padding: var(--sp-2) var(--gutter-mobile);
    color: var(--ink-on-dark);
    background: var(--bg-oxblood-well);
    text-align: center;
    transition: background-color var(--t-fast);
  }
  .site-header__newsletter-banner:hover {
    background: var(--accent-crimson);
  }
  .site-header__newsletter-banner:focus-visible {
    outline: 2px solid var(--ink-on-dark);
    outline-offset: -4px;
  }
  .site-header__newsletter-copy {
    font-family: var(--font-serif);
    font-size: var(--fs-meta);
    line-height: 1.4;
  }
  .site-header__newsletter-action {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    line-height: 1.4;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .site-header__desktop-nav {
    display: none;
    border-bottom: 1px solid var(--rule-hair);
  }
  .site-header__nav-list {
    display: flex;
    justify-content: space-between;
    max-width: 70rem;
    margin-inline: auto;
    padding-inline: var(--gutter-tablet);
  }
  .site-header__nav-link {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    color: var(--ink-secondary);
    font-family: var(--font-sans);
    font-size: var(--fs-nav);
    font-weight: var(--w-semibold);
    line-height: 1.4;
    letter-spacing: var(--tr-nav);
    text-transform: uppercase;
    transition: color var(--t-fast);
  }
  .nav-label {
    position: relative;
    display: inline-block;
  }
  .nav-label::after {
    content: "";
    position: absolute;
    inset: auto 0 calc(-1 * var(--nav-rule-offset));
    height: var(--nav-rule-width);
    background: var(--accent-crimson);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-nav);
  }
  .is-active {
    color: var(--ink-primary);
  }
  .is-active > .nav-label::after,
  a:hover > .nav-label::after,
  a:focus-visible > .nav-label::after {
    transform: scaleX(1);
  }
  .site-header__nav-link:hover,
  .site-menu__nav-link:hover {
    color: var(--accent-crimson);
  }
  .site-header__sentinel {
    display: block;
    height: 1px;
    margin-top: -1px;
    pointer-events: none;
  }
  .site-header__reading-bar {
    --header-edge: 3rem;
    position: fixed;
    z-index: var(--z-header);
    inset: 0 0 auto;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--rule-hair);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-100%);
    transition:
      transform 200ms var(--ease-panel),
      opacity 160ms var(--ease-panel);
  }
  .site-header__reading-bar.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .site-header__wordmark--reading {
    font-size: clamp(0.78rem, 3.3vw, 1rem);
  }
  dialog {
    position: fixed;
    border: 0;
    color: var(--ink-primary);
    background: var(--bg-page);
    max-width: none;
    max-height: none;
    overscroll-behavior: contain;
  }
  dialog::backdrop {
    background: rgb(15 15 15 / 12%);
  }
  .dialog-close {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--ink-primary);
    transition: color var(--t-fast);
  }
  .site-menu {
    inset: 0 0 0 auto;
    margin: 0;
    width: min(88vw, 22rem);
    height: 100dvh;
    padding: env(safe-area-inset-top, 0px) 0 env(safe-area-inset-bottom, 0px);
    border-inline-start: 1px solid var(--rule-hair);
    transform: translateX(100%);
    transition: transform 180ms var(--ease-panel);
  }
  .site-menu.is-visible {
    transform: translateX(0);
    transition-duration: 240ms;
  }
  .site-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    min-height: 4rem;
    padding-inline: var(--sp-5) var(--sp-2);
    border-bottom: 1px solid var(--rule-hair);
  }
  .site-menu__header h2 {
    font-family: var(--font-display);
    font-weight: var(--w-semibold);
    font-size: 0.875rem;
    line-height: 1.3;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }
  .site-menu__nav {
    padding: var(--sp-5);
  }
  .site-menu__nav-link {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    font-family: var(--font-sans);
    font-size: var(--fs-nav);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-nav);
    color: var(--ink-secondary);
    text-transform: uppercase;
    transition: color var(--t-fast);
  }
  .site-menu__nav-link.is-active {
    color: var(--ink-primary);
  }
  .site-menu__search-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    margin-top: var(--sp-5);
    border-top: 1px solid var(--rule-hair);
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    color: var(--accent-crimson);
  }
  .site-search {
    inset: 0 0 auto;
    margin: 0;
    width: 100%;
    max-height: 90dvh;
    padding: calc(var(--sp-3) + env(safe-area-inset-top, 0px)) var(--gutter-mobile) var(--sp-6);
    overflow-y: auto;
    border-bottom: 1px solid var(--rule-hair);
    opacity: 0;
    transition: opacity 160ms var(--ease-panel);
  }
  .site-search.is-visible {
    opacity: 1;
  }
  .site-search__inner {
    max-width: 48rem;
    margin-inline: auto;
  }
  .site-search__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-search__header h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--w-semibold);
  }
  @media (min-width: 32rem) {
    .site-header__newsletter-action {
      padding-inline-start: var(--sp-3);
      border-inline-start: 1px solid var(--rule-on-dark);
    }
  }
  @media (min-width: 48rem) {
    .site-header__masthead {
      --header-edge: 4.5rem;
      min-height: 5.5rem;
    }
    .header-control {
      min-height: 4rem;
    }
    .site-header__wordmark {
      font-size: clamp(1.35rem, 1rem + 0.8vw, 1.7rem);
      letter-spacing: 0.065em;
    }
    .site-header__desktop-nav {
      display: block;
    }
    .site-header__reading-bar {
      --header-edge: 3.75rem;
      min-height: 3.75rem;
    }
    .site-header__reading-bar .header-control {
      min-height: 3.75rem;
    }
    .site-header__wordmark--reading {
      font-size: 1.1rem;
    }
  }
</style>
