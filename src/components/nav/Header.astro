---
import { SUBSTACK_SUBSCRIBE_URL } from '~/lib/newsletter';
import HeaderSearch from '~/components/search/HeaderSearch.astro';
import SearchForm from '~/components/search/SearchForm.astro';
import SearchIcon from '~/components/search/SearchIcon.astro';

const navItems = [
  { href: '/', label: 'Latest' },
  { href: '/essays', label: 'Essays' },
  { href: '/series', label: 'Series' },
  { href: '/books', label: 'Books' },
  { href: '/about', label: 'About' },
];
const currentPath = Astro.url.pathname;
const Wordmark = currentPath === '/' ? 'h1' : 'span';
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header" data-site-header>
  <div class="site-header__flow" data-header-flow data-nosnippet>
    <div class="site-header__stage" data-header-stage>
      <div class="site-header__masthead" data-masthead>
        <a href="/search" class="header-control header-control--search" aria-label="Tìm kiếm" aria-controls="masthead-search" aria-expanded="false" data-search-open><SearchIcon /></a>
        <a href="/" class="site-header__wordmark-link" aria-label="The Cochinchine Pensées — home" data-masthead-logo><Wordmark class="site-header__wordmark">The Cochinchine Pensées</Wordmark></a>
        <button type="button" class="header-control header-control--menu" aria-controls="site-menu" aria-expanded="false" aria-label="Open navigation" data-menu-toggle>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path class="menu-line menu-line--top" d="M2 5h20"/><path class="menu-line menu-line--middle" d="M2 12h20"/><path class="menu-line menu-line--bottom" d="M2 19h20"/></svg>
        </button>
      </div>
      <a href={SUBSTACK_SUBSCRIBE_URL} class="site-header__newsletter-banner" rel="external" data-newsletter-banner>
        <span class="site-header__newsletter-copy" lang="vi">Nhận thông tin bài viết mới</span>
        <span class="site-header__newsletter-action">Subscribe on Substack <span aria-hidden="true">→</span></span>
      </a>
      <HeaderSearch id="masthead-search" />
    </div>
    <nav class="site-header__desktop-nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {navItems.map((item) => <li><a href={item.href} class:list={['site-header__nav-link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}><span class="nav-label">{item.label}</span></a></li>)}
      </ul>
    </nav>
  </div>
  <span class="site-header__sentinel" data-header-sentinel aria-hidden="true"></span>

  <div class="site-header__reading-bar" data-reading-bar aria-hidden="true" inert data-nosnippet>
    <a href="/search" class="header-control header-control--search" aria-label="Tìm kiếm" aria-controls="reading-search" aria-expanded="false" data-search-open><SearchIcon /></a>
    <a href="/" class="site-header__wordmark-link" aria-label="The Cochinchine Pensées — home" data-masthead-logo><span class="site-header__wordmark site-header__wordmark--reading">The Cochinchine Pensées</span></a>
    <button type="button" class="header-control header-control--menu" aria-controls="site-menu" aria-expanded="false" aria-label="Open navigation" data-menu-toggle>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path class="menu-line menu-line--top" d="M2 5h20"/><path class="menu-line menu-line--middle" d="M2 12h20"/><path class="menu-line menu-line--bottom" d="M2 19h20"/></svg>
    </button>
    <HeaderSearch id="reading-search" compact />
  </div>

  <nav id="site-menu" class="site-menu" aria-label="Menu" aria-hidden="true" inert data-site-menu data-nosnippet>
    <SearchForm id="menu-search" variant="menu" />
    <ul>
      {navItems.map((item) => <li><a href={item.href} class:list={['site-menu__nav-link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}><span class="nav-label">{item.label}</span></a></li>)}
    </ul>
  </nav>
</header>

<script>
  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.ready) return;
    header.dataset.ready = 'true';
    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const flow = header.querySelector<HTMLElement>('[data-header-flow]')!;
    const masthead = header.querySelector<HTMLElement>('[data-masthead]')!;
    const bar = header.querySelector<HTMLElement>('[data-reading-bar]')!;
    const menu = header.querySelector<HTMLElement>('[data-site-menu]')!;
    const desktop = matchMedia('(min-width: 48rem)');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let compact = false;
    let menuOpen = false;
    let search: HTMLElement | null = null;
    let searchTrigger: HTMLElement | null = null;
    let menuTrigger: HTMLElement | null = null;
    let focusTimer: ReturnType<typeof setTimeout>;
    const pageInert = new Map<HTMLElement, boolean>();

    const updateMenuTop = () => {
      if (!menuOpen) return;
      const bottom = compact ? bar.offsetHeight : masthead.getBoundingClientRect().bottom;
      header.style.setProperty('--menu-top', `${Math.max(0, bottom)}px`);
    };
    const closeMenu = (restore = true) => {
      if (!menuOpen) return;
      menuOpen = false;
      header.classList.remove('is-menu-open');
      menu.inert = true;
      menu.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('has-site-menu');
      for (const button of header.querySelectorAll('[data-menu-toggle]')) {
        button.setAttribute('aria-expanded', 'false');
        button.setAttribute('aria-label', 'Open navigation');
      }
      for (const [element, previous] of pageInert) element.inert = previous;
      pageInert.clear();
      if (restore && menuTrigger?.isConnected) menuTrigger.focus({ preventScroll: true });
      menuTrigger = null;
    };
    const closeSearch = (restore = true) => {
      clearTimeout(focusTimer);
      if (!search) return;
      const region = search.closest<HTMLElement>('[data-header-stage], [data-reading-bar]')!;
      search.classList.remove('is-open');
      search.inert = true;
      search.setAttribute('aria-hidden', 'true');
      region.classList.remove('is-search-open');
      for (const element of region.querySelectorAll<HTMLElement>(
        '[data-masthead-logo], [data-search-open], [data-newsletter-banner]',
      )) {
        element.inert = false;
        element.removeAttribute('aria-hidden');
      }
      searchTrigger?.setAttribute('aria-expanded', 'false');
      if (restore && searchTrigger?.isConnected) searchTrigger.focus({ preventScroll: true });
      search = null;
      searchTrigger = null;
    };
    const openSearch = (trigger: HTMLElement) => {
      closeMenu(false);
      closeSearch(false);
      const region = trigger.closest<HTMLElement>('[data-header-stage], [data-reading-bar]')!;
      search = region.querySelector<HTMLElement>('[data-header-search]')!;
      searchTrigger = trigger;
      region.classList.add('is-search-open');
      search.inert = false;
      search.setAttribute('aria-hidden', 'false');
      search.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      for (const element of region.querySelectorAll<HTMLElement>(
        '[data-masthead-logo], [data-search-open], [data-newsletter-banner]',
      )) {
        element.inert = true;
        element.setAttribute('aria-hidden', 'true');
      }
      // Focus after the slide so keyboard focus cannot scroll the clipped form.
      const opened = search;
      focusTimer = setTimeout(
        () => {
          if (search === opened) opened.querySelector('input')?.focus({ preventScroll: true });
        },
        reduced.matches ? 0 : 240,
      );
    };
    const toggleMenu = (trigger: HTMLElement) => {
      if (menuOpen) {
        closeMenu();
        return;
      }
      closeSearch(false);
      menuTrigger = trigger;
      menuOpen = true;
      updateMenuTop();
      menu.inert = false;
      menu.setAttribute('aria-hidden', 'false');
      header.classList.add('is-menu-open');
      document.documentElement.classList.add('has-site-menu');
      for (const button of header.querySelectorAll('[data-menu-toggle]')) {
        button.setAttribute('aria-expanded', 'true');
        button.setAttribute('aria-label', 'Close navigation');
      }
      // The masthead remains usable; background links leave keyboard navigation.
      for (const element of document.querySelectorAll<HTMLElement>(
        'main, .site-footer, .site-header__desktop-nav, [data-newsletter-banner]',
      )) {
        pageInert.set(element, element.inert);
        element.inert = true;
      }
    };
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry) return;
      const next = entry.boundingClientRect.bottom <= 0;
      if (next !== compact) {
        closeSearch(false);
        closeMenu(false);
      }
      compact = next;
      bar.classList.toggle('is-visible', compact);
      bar.inert = !compact;
      bar.setAttribute('aria-hidden', String(!compact));
      flow.inert = compact;
      if (compact) flow.setAttribute('aria-hidden', 'true');
      else flow.removeAttribute('aria-hidden');
    });
    observer.observe(header.querySelector('[data-header-sentinel]')!);
    const resize = new ResizeObserver(updateMenuTop);
    resize.observe(masthead);
    resize.observe(bar);
    desktop.addEventListener(
      'change',
      () => {
        closeSearch(false);
        updateMenuTop();
      },
      { signal },
    );
    for (const trigger of header.querySelectorAll<HTMLElement>('[data-search-open]')) {
      trigger.addEventListener(
        'click',
        (event) => {
          if (
            event instanceof MouseEvent &&
            (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          )
            return;
          if (!desktop.matches) return;
          event.preventDefault();
          openSearch(trigger);
        },
        { signal },
      );
    }
    for (const button of header.querySelectorAll<HTMLElement>('[data-menu-toggle]')) {
      button.addEventListener('click', () => toggleMenu(button), { signal });
    }
    for (const button of header.querySelectorAll('[data-search-close]')) {
      button.addEventListener('click', () => closeSearch(), { signal });
    }
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape' || event.isComposing) return;
        if (search || menuOpen) {
          event.preventDefault();
          closeSearch();
          closeMenu();
        }
      },
      { signal },
    );
    document.addEventListener(
      'pointerdown',
      (event) => {
        if (!(event.target instanceof Node) || header.contains(event.target)) return;
        closeMenu(false);
        closeSearch(false);
      },
      { signal },
    );
    document.addEventListener(
      'astro:before-swap',
      () => {
        closeSearch(false);
        closeMenu(false);
        observer.disconnect();
        resize.disconnect();
        lifecycle.abort();
      },
      { once: true, signal },
    );
  }
  document.addEventListener('astro:page-load', initHeader);
  initHeader();
</script>

<style>
  .site-header {
    position: relative;
    background: var(--bg-page);
  }
  .site-header__stage {
    --header-edge: 3rem;
    position: relative;
  }
  .site-header__masthead,
  .site-header__reading-bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--header-edge);
    align-items: center;
    background: var(--bg-page);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .site-header__masthead {
    position: relative;
    z-index: 1;
    min-height: 4rem;
  }
  .header-control {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 3rem;
    color: var(--ink-primary);
    background: var(--bg-page);
    transition: color var(--t-nav);
  }
  .header-control:hover {
    color: var(--accent-crimson);
  }
  .header-control--search {
    display: none;
  }
  .header-control--menu {
    position: relative;
    z-index: 3;
    align-self: stretch;
  }
  .site-header__wordmark-link {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-inline-start: var(--gutter-mobile);
    min-width: 0;
    min-height: 44px;
    color: var(--ink-primary);
  }
  .site-header__wordmark {
    font-family: var(--font-display);
    font-size: clamp(0.78rem, 3.4vw, 1.2rem);
    font-weight: var(--w-semibold);
    line-height: 1.2;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .site-header__newsletter-banner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    column-gap: var(--sp-3);
    row-gap: var(--sp-1);
    min-height: 44px;
    padding: var(--sp-2) var(--gutter-mobile);
    color: var(--ink-on-dark);
    background: var(--bg-oxblood-well);
    text-align: center;
    transition:
      background-color var(--t-fast),
      opacity 180ms var(--ease-panel);
  }
  .site-header__newsletter-banner:hover {
    background: var(--accent-crimson);
  }
  .site-header__newsletter-banner:focus-visible {
    outline: 2px solid var(--ink-on-dark);
    outline-offset: -4px;
  }
  .site-header__newsletter-copy {
    font-family: var(--font-serif);
    font-size: var(--fs-meta);
    line-height: 1.4;
  }
  .site-header__newsletter-action {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    line-height: 1.4;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .is-search-open .site-header__newsletter-banner {
    opacity: 0;
    pointer-events: none;
  }
  .is-menu-open .site-header__newsletter-banner {
    opacity: 0;
  }
  .site-header__desktop-nav {
    display: none;
    border-bottom: 1px solid var(--rule-hair);
  }
  .site-header__nav-list {
    display: flex;
    justify-content: space-between;
    max-width: 70rem;
    margin-inline: auto;
    padding-inline: var(--gutter-tablet);
  }
  .site-header__nav-link {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    color: var(--ink-secondary);
    font-family: var(--font-sans);
    font-size: var(--fs-nav);
    font-weight: var(--w-semibold);
    line-height: 1.4;
    letter-spacing: var(--tr-nav);
    text-transform: uppercase;
    transition: color var(--t-nav);
  }
  .nav-label {
    position: relative;
    display: inline-block;
  }
  .nav-label::after {
    content: "";
    position: absolute;
    inset: auto 0 calc(-1 * var(--nav-rule-offset));
    height: var(--nav-rule-width);
    background: var(--accent-crimson);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-nav);
  }
  .is-active {
    color: var(--ink-primary);
  }
  .is-active > .nav-label::after,
  a:hover > .nav-label::after,
  a:focus-visible > .nav-label::after {
    transform: scaleX(1);
  }
  .site-header__nav-link:hover,
  .site-menu__nav-link:hover {
    color: var(--accent-crimson);
  }
  .site-header__sentinel {
    display: block;
    height: 1px;
    margin-top: -1px;
    pointer-events: none;
  }
  .site-header__reading-bar {
    --header-edge: 3rem;
    position: fixed;
    z-index: var(--z-header);
    inset: 0 0 auto;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--rule-hair);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-100%);
    transition:
      transform 200ms var(--ease-panel),
      opacity 160ms var(--ease-panel);
  }
  .site-header__reading-bar.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .site-header__wordmark--reading {
    font-size: clamp(0.78rem, 3.3vw, 1rem);
  }
  .menu-line {
    transform-origin: center;
    transition:
      transform 180ms var(--ease-panel),
      opacity 140ms var(--ease-panel);
  }
  .is-menu-open .menu-line--top {
    transform: rotate(45deg) translateY(7px);
  }
  .is-menu-open .menu-line--middle {
    opacity: 0;
  }
  .is-menu-open .menu-line--bottom {
    transform: rotate(-45deg) translateY(-7px);
  }
  .site-menu {
    position: fixed;
    z-index: var(--z-header);
    top: var(--menu-top, 4rem);
    right: 0;
    width: min(80vw, 22rem);
    height: calc(100dvh - var(--menu-top, 4rem));
    padding: var(--sp-6) var(--sp-5) calc(var(--sp-6) + env(safe-area-inset-bottom, 0px));
    border-inline-start: 1px solid var(--rule-hair);
    border-block: 1px solid var(--rule-hair);
    background: var(--bg-page);
    color: var(--ink-primary);
    overflow-y: auto;
    overscroll-behavior: contain;
    visibility: hidden;
    transform: translateX(100%);
    transition:
      transform 180ms var(--ease-panel),
      visibility 0s 180ms;
  }
  .is-menu-open .site-menu {
    visibility: visible;
    transform: translateX(0);
    transition-duration: 240ms, 0s;
    transition-delay: 0s;
  }
  .site-menu ul {
    margin-top: var(--sp-5);
  }
  .site-menu__nav-link {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    font-family: var(--font-sans);
    font-size: var(--fs-nav);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-nav);
    color: var(--ink-secondary);
    text-transform: uppercase;
    transition: color var(--t-nav);
  }
  .site-menu__nav-link.is-active {
    color: var(--ink-primary);
  }
  @media (min-width: 32rem) {
    .site-header__newsletter-banner {
      flex-direction: row;
    }
    .site-header__newsletter-action {
      padding-inline-start: var(--sp-3);
      border-inline-start: 1px solid var(--rule-on-dark);
    }
  }
  @media (min-width: 48rem) {
    .site-header__stage {
      --header-edge: 4.5rem;
    }
    .site-header__masthead,
    .site-header__reading-bar {
      grid-template-columns: var(--header-edge) minmax(0, 1fr) var(--header-edge);
    }
    .site-header__masthead {
      min-height: 5.5rem;
    }
    .is-search-open .site-header__masthead .header-control--menu {
      position: absolute;
      inset-block-start: 0;
      inset-inline-end: 0;
      width: var(--header-edge);
      height: calc(100% + 2.75rem);
    }
    .header-control {
      min-height: 4rem;
    }
    .header-control--search {
      display: grid;
    }
    .site-header__wordmark-link {
      justify-content: center;
      padding-inline-start: 0;
    }
    .site-header__wordmark {
      font-size: clamp(1.35rem, 1rem + 0.8vw, 1.7rem);
      letter-spacing: 0.065em;
    }
    .site-header__desktop-nav {
      display: block;
    }
    .site-header__reading-bar {
      --header-edge: 3.75rem;
      min-height: 3.75rem;
    }
    .site-header__reading-bar .header-control {
      min-height: 3.75rem;
    }
    .site-header__wordmark--reading {
      font-size: 1.1rem;
    }
  }
</style>
