---
/**
 * /essays/2, /essays/3, … — pages 2+ of the essay archive.
 *
 * Page 1 is served by index.astro at /essays, so this route starts at 2.
 * Numeric params only; essay slugs stay with [...slug].astro. Astro gives
 * static routes precedence over rest params, so the generated numbers win.
 *
 * Same layout switch as index.astro: rows on mobile, card grid on desktop.
 */
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import EssayRow from '~/components/essay/EssayRow.astro';
import EssayCard from '~/components/essay/EssayCard.astro';
import Pagination from '~/components/nav/Pagination.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { PER_PAGE } from '~/lib/pagination';
import { ARCHIVE_IMAGE_SIZES } from '~/lib/responsiveImage';

export const getStaticPaths = (async () => {
  const allEssays = await getCollection('essays', ({ data }) => !data.draft);
  const sorted = allEssays.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const lastPage = Math.max(1, Math.ceil(sorted.length / PER_PAGE));

  const pages = [];
  for (let page = 2; page <= lastPage; page += 1) {
    const start = (page - 1) * PER_PAGE;
    pages.push({
      params: { page: String(page) },
      props: {
        essays: sorted.slice(start, start + PER_PAGE),
        total: sorted.length,
        currentPage: page,
        lastPage,
      },
    });
  }

  return pages;
}) satisfies GetStaticPaths;

const { essays, total, currentPage, lastPage } = Astro.props;

const prevUrl = currentPage === 2 ? '/essays' : `/essays/${currentPage - 1}`;
const nextUrl = currentPage < lastPage ? `/essays/${currentPage + 1}` : undefined;
---

<BaseLayout
  title={`Essays — page ${currentPage}`}
  description="All essays published in The Cochinchine Pensées."
>
  <section class="archive">
    <div class="container">
      <header class="archive__header">
        <p class="archive__eyebrow">Archive</p>
        <h1 class="archive__title">All Essays</h1>
        <p class="archive__subtitle">
          {total} essays, sorted from most recent.
        </p>
      </header>

      <ul class="archive__list archive__list--rows" data-archive-rows>
        {essays.map((essay) => (
          <li>
            <EssayRow essay={essay} />
          </li>
        ))}
      </ul>

      <ul class="archive__list archive__list--grid" data-archive-grid>
        {essays.map((essay) => (
          <li>
            <EssayCard essay={essay} imageSizes={ARCHIVE_IMAGE_SIZES} />
          </li>
        ))}
      </ul>

      <Pagination
        prevUrl={prevUrl}
        nextUrl={nextUrl}
        currentPage={currentPage}
        lastPage={lastPage}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    padding-block: var(--sp-12) var(--sp-16);
  }

  .archive__header {
    text-align: center;
    margin-bottom: var(--sp-12);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule-hair);
  }

  .archive__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-3);
  }

  .archive__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1.1;
    color: var(--ink-primary);
    margin-bottom: var(--sp-3);
  }

  .archive__subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-secondary);
    font-size: var(--fs-body);
    margin-bottom: var(--sp-5);
  }

  /* Mobile: row list. Desktop: hidden via media query below. */
  .archive__list--grid {
    display: none;
  }

  .archive__list--rows {
    display: block;
    max-width: 56rem;
    margin-inline: auto;
  }

  .archive__list--rows > li:last-child :global(.essay-row) {
    border-bottom: 1px solid var(--rule-hair);
  }

  /* Desktop: card grid (CRB-style). */
  @media (min-width: 48rem) {
    .archive__list--rows {
      display: none;
    }

    .archive__list--grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--sp-8);
      row-gap: var(--sp-12);
      max-width: 70rem;
      margin-inline: auto;
    }
  }

  @media (min-width: 75rem) {
    .archive__list--grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--sp-10);
    }
  }
</style>
