---
/**
 * Essays archive — every published essay, newest first.
 *
 * Mobile (<48rem): a single column of date-left / title-middle / cover-right rows,
 * the same way readers scroll a Twitter feed. Ten rows to a page.
 *
 * Desktop (≥48rem): a 3-column grid of cover-card tiles — the
 * Claremont Review pattern. Generous gutters and breathing room.
 * Pagination: "1 OF N · NEXT PAGE >" centered below.
 *
 * Page 1 lives at /essays; pages 2+ are generated by [page].astro, which
 * shares this markup.
 */
import { getCollection } from 'astro:content';
import EssayRow from '~/components/essay/EssayRow.astro';
import EssayCard from '~/components/essay/EssayCard.astro';
import Pagination from '~/components/nav/Pagination.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { PER_PAGE } from '~/lib/pagination';
import { ARCHIVE_IMAGE_SIZES } from '~/lib/responsiveImage';

const allEssays = await getCollection('essays', ({ data }) => !data.draft);
const sortedEssays = allEssays.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const essays = sortedEssays.slice(0, PER_PAGE);
const lastPage = Math.max(1, Math.ceil(sortedEssays.length / PER_PAGE));
---

<BaseLayout
  title="Essays"
  description="Kho tiểu luận tiếng Việt của The Cochinchine Pensées về chính trị, văn hóa, xã hội và tư tưởng. Tìm bài viết theo thời gian, từ mới nhất đến cũ hơn."
>
  <section class="archive">
    <div class="container">
      <header class="archive__header">
        <p class="archive__eyebrow">Archive</p>
        <h1 class="archive__title">All Essays</h1>
      </header>

      <ul class="archive__list archive__list--rows" data-archive-rows>
        {essays.map((essay) => (
          <li>
            <EssayRow essay={essay} />
          </li>
        ))}
      </ul>

      <ul class="archive__list archive__list--grid" data-archive-grid>
        {essays.map((essay) => (
          <li>
            <EssayCard essay={essay} imageSizes={ARCHIVE_IMAGE_SIZES} />
          </li>
        ))}
      </ul>

      <Pagination
        prevUrl={undefined}
        nextUrl={lastPage > 1 ? '/essays/2' : undefined}
        currentPage={1}
        lastPage={lastPage}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    padding-block: var(--sp-12) var(--sp-16);
  }

  .archive__header {
    text-align: center;
    margin-bottom: var(--sp-8);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule-hair);
  }

  .archive__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-3);
  }

  .archive__title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: 1.1;
    color: var(--ink-primary);
    margin-bottom: var(--sp-3);
  }


  /* Mobile: row list. Desktop: hidden via media query below. */
  .archive__list--grid {
    display: none;
  }

  .archive__list--rows {
    display: block;
    max-width: 56rem;
    margin-inline: auto;
  }

  .archive__list--rows > li:last-child :global(.essay-row) {
    border-bottom: 1px solid var(--rule-hair);
  }

  /* Desktop: card grid (CRB-style). */
  @media (min-width: 48rem) {
    .archive__list--rows {
      display: none;
    }

    .archive__list--grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--sp-8);
      row-gap: var(--sp-12);
      max-width: 70rem;
      margin-inline: auto;
    }
  }

  @media (min-width: 75rem) {
    .archive__list--grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--sp-10);
    }
  }
</style>
