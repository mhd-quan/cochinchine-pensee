---
/**
 * Essays archive page — list all essays (no drafts).
 * Pagefind search slot reserved for Phase 1 month 4.
 */
import { getCollection } from 'astro:content';
import EssayCard from '~/components/essay/EssayCard.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';

const allEssays = await getCollection('essays', ({ data }) => !data.draft);
const sortedEssays = allEssays.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year for visual rhythm
const essaysByYear = sortedEssays.reduce<Record<string, typeof sortedEssays>>((acc, essay) => {
  const year = String(essay.data.date.getFullYear());
  if (!acc[year]) acc[year] = [];
  acc[year].push(essay);
  return acc;
}, {});

const years = Object.keys(essaysByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Essays"
  description="All essays published in The Cochinchine Pensée."
>
  <section class="archive">
    <div class="container">
      <header class="archive__header">
        <p class="archive__eyebrow">Archive</p>
        <h1 class="archive__title">All Essays</h1>
        <p class="archive__subtitle">
          {sortedEssays.length} essays, sorted from most recent.
        </p>
        <div class="archive__search" aria-label="Search (coming soon)">
          <span class="archive__search-glyph" aria-hidden="true">⌕</span>
          <span class="archive__search-placeholder">Search essays (coming soon)</span>
        </div>
      </header>

      {years.map((year) => (
        <section class="archive__year">
          <h2 class="archive__year-heading">{year}</h2>
          <ul class="archive__grid">
            {essaysByYear[year].map((essay) => (
              <li>
                <EssayCard essay={essay} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    padding-block: var(--sp-12) var(--sp-16);
  }

  .archive__header {
    text-align: center;
    margin-bottom: var(--sp-12);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule-hair);
  }

  .archive__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-3);
  }

  .archive__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1.1;
    color: var(--ink-primary);
    margin-bottom: var(--sp-3);
  }

  .archive__subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-secondary);
    font-size: var(--fs-body);
    margin-bottom: var(--sp-5);
  }

  .archive__search {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--rule-hair);
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    color: var(--ink-muted);
  }

  .archive__search-glyph {
    font-family: var(--font-glyph);
    color: var(--accent-crimson);
  }

  .archive__year {
    margin-bottom: var(--sp-10);
  }

  .archive__year-heading {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: 1;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-5);
    padding-bottom: var(--sp-3);
    border-bottom: 2px solid var(--ink-primary);
    font-style: italic;
  }

  .archive__grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--sp-6);
    row-gap: 0;
  }

  @media (min-width: 640px) {
    .archive__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .archive__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
