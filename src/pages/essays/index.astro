---
/**
 * Essays archive — every published essay, newest first.
 *
 * One essay per row, ten rows to a page. Page 1 lives at /essays;
 * pages 2+ are generated by [page].astro, which shares this markup.
 * Pagefind search slot reserved for Phase 1 month 4.
 */
import { getCollection } from 'astro:content';
import EssayRow from '~/components/essay/EssayRow.astro';
import Pagination from '~/components/nav/Pagination.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { PER_PAGE } from '~/lib/pagination';

const allEssays = await getCollection('essays', ({ data }) => !data.draft);
const sortedEssays = allEssays.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const essays = sortedEssays.slice(0, PER_PAGE);
const lastPage = Math.max(1, Math.ceil(sortedEssays.length / PER_PAGE));
---

<BaseLayout
  title="Essays"
  description="All essays published in The Cochinchine Pensées."
>
  <section class="archive">
    <div class="container">
      <header class="archive__header">
        <p class="archive__eyebrow">Archive</p>
        <h1 class="archive__title">All Essays</h1>
        <p class="archive__subtitle">
          {sortedEssays.length} essays, sorted from most recent.
        </p>
        <div class="archive__search" aria-label="Search (coming soon)">
          <span class="archive__search-glyph" aria-hidden="true">⌕</span>
          <span class="archive__search-placeholder">Search essays (coming soon)</span>
        </div>
      </header>

      <ul class="archive__list">
        {essays.map((essay) => (
          <li>
            <EssayRow essay={essay} />
          </li>
        ))}
      </ul>

      <Pagination
        prevUrl={undefined}
        nextUrl={lastPage > 1 ? '/essays/2' : undefined}
        currentPage={1}
        lastPage={lastPage}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    padding-block: var(--sp-12) var(--sp-16);
  }

  .archive__header {
    text-align: center;
    margin-bottom: var(--sp-12);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule-hair);
  }

  .archive__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-3);
  }

  .archive__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1.1;
    color: var(--ink-primary);
    margin-bottom: var(--sp-3);
  }

  .archive__subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-secondary);
    font-size: var(--fs-body);
    margin-bottom: var(--sp-5);
  }

  .archive__search {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--rule-hair);
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    color: var(--ink-muted);
  }

  .archive__search-glyph {
    font-family: var(--font-glyph);
    color: var(--accent-crimson);
  }

  /* CRB-style bounded measure: the list never sprawls the full container,
   * so titles stay a gutter away from their thumbnails on wide screens. */
  .archive__list {
    display: block;
    max-width: 56rem;
    margin-inline: auto;
  }

  .archive__list > li:last-child :global(.essay-row) {
    border-bottom: 1px solid var(--rule-hair);
  }
</style>
