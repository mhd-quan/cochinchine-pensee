---
/**
 * /books — Book reviews archive.
 * Each book links to the essay that reviewed it.
 */
import { getCollection } from 'astro:content';
import BookCard from '~/components/essay/BookCard.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';

const allBooks = await getCollection('books');
const allEssays = await getCollection('essays', ({ data }) => !data.draft);
const essaysById = new Map(allEssays.map((e) => [e.id, e]));

// Newest first, dated by the essay that reviewed each book.
const books = allBooks
  .map((book) => ({ book, essay: essaysById.get(book.data.reviewEssayId) }))
  .filter((pair) => pair.essay !== undefined)
  .sort((a, b) => b.essay!.data.date.valueOf() - a.essay!.data.date.valueOf())
  .map(({ book }) => book);
---

<BaseLayout
  title="Books"
  description="Điểm sách trên The Cochinchine Pensées: những tác phẩm về văn chương, triết học, chính trị và xã hội, cùng các bài tiểu luận đọc và bàn về chúng."
>
  <section class="books">
    <div class="container">
      <header class="books__header">
        <p class="books__eyebrow">The Stacks</p>
        <h1 class="books__title">Books Reviewed</h1>
        <p class="books__subtitle">
          The works these essays read. Each one links to the essay that
          reviewed it.
        </p>
      </header>

      <ul class="books__grid">
        {books.map((book) => (
          <li>
            <BookCard book={book} />
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .books {
    padding-block: var(--sp-12) var(--sp-16);
  }

  .books__header {
    text-align: center;
    margin-bottom: var(--sp-10);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule-hair);
  }

  .books__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-3);
  }

  .books__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1.1;
    color: var(--ink-primary);
    margin-bottom: var(--sp-3);
  }

  .books__subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-body-larger);
    color: var(--ink-secondary);
    max-width: 36rem;
    margin-inline: auto;
  }

  .books__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--sp-5);
    row-gap: 0;
  }

  @media (min-width: 640px) {
    .books__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .books__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .books__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
