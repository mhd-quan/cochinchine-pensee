---
/**
 * Homepage — single-column CRB style, refined per user feedback (Aug 2026):
 *   1. Hero essay (latest, with cover image)
 *   2. "Recent Essays" grid
 *   3. "From the Stacks" book reviews grid
 *   4. One browsable series carousel
 *
 * No right rail, no utility nav, no floating issue line in header.
 */
import { getCollection } from 'astro:content';
import BookCard from '~/components/essay/BookCard.astro';
import EssayCard from '~/components/essay/EssayCard.astro';
import SeriesCarousel from '~/components/essay/SeriesCarousel.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SiteIdentity from '~/components/seo/SiteIdentity.astro';
import { titleCaps } from '~/lib/titleCaps';

const allEssays = await getCollection('essays', ({ data }) => !data.draft);
const sortedEssays = allEssays.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const essaysById = new Map(sortedEssays.map((e) => [e.id, e]));

const heroEssay = sortedEssays[0];
const siteDescription = 'The Cochinchine Pensées — tiểu luận tiếng Việt về chính trị, văn hóa và văn chương. Đọc bài viết mới, điểm sách và các loạt bài trên website của ấn phẩm.';
// Max three rows on the widest grid (3 columns); CSS trims to 3 rows at
// narrower breakpoints too. Everything else lives at /essays.
const recentEssays = sortedEssays.slice(1, 10);

// Books run newest-first, dated by the essay that reviewed them.
const allBooks = await getCollection('books');
const stackBooks = allBooks
  .map((book) => ({ book, essay: essaysById.get(book.data.reviewEssayId) }))
  .filter((pair) => pair.essay !== undefined)
  .sort((a, b) => b.essay!.data.date.valueOf() - a.essay!.data.date.valueOf())
  .map(({ book }) => book);

// Homepage clusters show published work only — a series appears once it has
// at least one live essay. Announced slots are left for the series page.
const featuredSeries = await getCollection('series', ({ data }) => data.featured);
const featuredClusters = featuredSeries
  .map((series) => ({
    series,
    essays: series.data.essayIds
      .map((id) => essaysById.get(id))
      .filter((essay) => essay !== undefined),
  }))
  .filter(({ essays }) => essays.length > 0)
  .sort((a, b) => Math.max(...b.essays.map((essay) => +essay.data.date)) - Math.max(...a.essays.map((essay) => +essay.data.date)));
---

<BaseLayout
  title="The Cochinchine Pensées"
  description={siteDescription}
  canonicalUrl="/"
>
  <SiteIdentity slot="head" description={siteDescription} />
  {/* ── Hero essay ── */}
  {heroEssay && (
    <section class="hero">
      <div class="container">
        <p class="hero__eyebrow">Latest Essay</p>
        <h2 class="hero__title">
          <a href={`/essays/${heroEssay.id}`}>
            {titleCaps(heroEssay.data.title).map((segment) => (
              segment.small
                ? <span class="title-caps__small">{segment.text}</span>
                : <span>{segment.text}</span>
            ))}
          </a>
        </h2>
        {heroEssay.data.subtitle && (
          <p class="hero__subtitle">{heroEssay.data.subtitle}</p>
        )}
        <p class="hero__meta">
          <span class="hero__byline">by <em>{heroEssay.data.author}</em></span>
          <span aria-hidden="true">·</span>
          <time datetime={heroEssay.data.date.toISOString()}>
            {heroEssay.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </p>
      </div>
    </section>
  )}

  {/* ── Recent essays ── */}
  <section class="recent container">
    <div class="recent__header">
      <h3 class="recent__heading">Recent Essays</h3>
      <a href="/essays" class="recent__more">All essays →</a>
    </div>

    <ul class="recent__grid">
      {recentEssays.map((essay, index) => (
        <li>
          <EssayCard essay={essay} priority={index === 0} />
        </li>
      ))}
    </ul>
  </section>

  {/* ── From the Stacks — book reviews, newest first, horizontally scrollable ── */}
  {stackBooks.length > 0 && (
    <section class="stacks container" data-stacks>
      <div class="stacks__header">
        <h3 class="stacks__heading">From the Stacks</h3>
        <div class="stacks__header-end">
          <div class="stacks__controls">
            <button
              type="button"
              class="stacks__arrow"
              data-stacks-prev
              aria-label="Previous books"
              aria-controls="stacks-track"
              disabled
            >
              <span aria-hidden="true">&lt;</span>
            </button>
            <button
              type="button"
              class="stacks__arrow"
              data-stacks-next
              aria-label="More books"
              aria-controls="stacks-track"
            >
              <span aria-hidden="true">&gt;</span>
            </button>
          </div>
          <a href="/books" class="stacks__more">All books →</a>
        </div>
      </div>

      <ul id="stacks-track" class="stacks__track" data-stacks-track tabindex="0">
        {stackBooks.map((book) => (
          <li class="stacks__slide">
            <BookCard book={book} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <SeriesCarousel clusters={featuredClusters} />
</BaseLayout>

<script>
  function initStacks() {
    for (const section of document.querySelectorAll<HTMLElement>('[data-stacks]')) {
      if (section.dataset.initialized === 'true') continue;

      const track = section.querySelector<HTMLElement>('[data-stacks-track]');
      const prev = section.querySelector<HTMLButtonElement>('[data-stacks-prev]');
      const next = section.querySelector<HTMLButtonElement>('[data-stacks-next]');
      if (!track || !prev || !next) continue;

      section.dataset.initialized = 'true';

      // Listeners are torn down before Astro swaps the page, so repeated
      // client-side navigations don't stack duplicates on window.
      const lifecycle = new AbortController();
      const { signal } = lifecycle;

      const step = () => {
        const slide = track.querySelector<HTMLElement>('.stacks__slide');
        if (!slide) return track.clientWidth;
        const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
        return slide.getBoundingClientRect().width + gap;
      };

      // Advance by a full view, keeping one slide on screen for continuity.
      const page = () => {
        const one = step();
        const perView = Math.max(1, Math.floor(track.clientWidth / one));
        return one * Math.max(1, perView - 1);
      };

      let frame = 0;
      let nearby = false;
      const sync = () => {
        frame = 0;
        // Read layout together before changing either control.
        const max = track.scrollWidth - track.clientWidth;
        const position = track.scrollLeft;
        prev.disabled = position <= 1;
        next.disabled = position >= max - 1;
      };
      const scheduleSync = () => {
        if (nearby && !frame) frame = requestAnimationFrame(sync);
      };
      const visibility = new IntersectionObserver(([entry]) => {
        nearby = entry.isIntersecting;
        scheduleSync();
      }, { rootMargin: '300px' });
      visibility.observe(section);
      const resize = new ResizeObserver(scheduleSync);
      resize.observe(track);

      prev.addEventListener('click', () => {
        track.scrollBy({ left: -page(), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      }, { signal });

      next.addEventListener('click', () => {
        track.scrollBy({ left: page(), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      }, { signal });

      track.addEventListener('scroll', scheduleSync, { passive: true, signal });

      document.addEventListener('astro:before-swap', () => {
        lifecycle.abort();
        visibility.disconnect();
        resize.disconnect();
        cancelAnimationFrame(frame);
        delete section.dataset.initialized;
      }, { once: true, signal });
    }
  }

  document.addEventListener('astro:page-load', initStacks);
  initStacks();
</script>

<style>
  /* Hero */
  .hero {
    padding-block: var(--sp-12) var(--sp-10);
    border-bottom: 1px solid var(--rule-hair);
    text-align: center;
    background: var(--bg-page);
  }

  .hero__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-4);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: 0.015em;
    color: var(--ink-primary);
    margin-bottom: var(--sp-4);
    text-wrap: balance;
  }

  .hero__title a {
    color: inherit;
    transition: color var(--t-base);
  }

  .hero__title a:hover {
    color: var(--accent-crimson);
  }

  .hero__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    line-height: var(--lh-headline);
    color: var(--ink-secondary);
    margin-bottom: var(--sp-5);
    max-width: 36rem;
    margin-inline: auto;
    text-wrap: balance;
  }

  .hero__meta {
    font-family: var(--font-serif);
    font-size: var(--fs-meta);
    color: var(--ink-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .hero__byline em {
    color: var(--accent-crimson);
  }

  /* Section primitives */
  .recent,
  .stacks {
    padding-block: var(--sp-10);
  }

  .recent__header,
  .stacks__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-3);
    border-bottom: 2px solid var(--ink-primary);
    gap: var(--sp-4);
  }

  .recent__heading,
  .stacks__heading {
    font-family: var(--font-sans);
    font-size: var(--fs-h4);
    font-weight: var(--w-bold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-primary);
  }

  .recent__more,
  .stacks__more {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    border-bottom: 1px solid transparent;
    transition: color var(--t-base),
                border-color var(--t-base);
    white-space: nowrap;
  }

  .recent__more:hover,
  .stacks__more:hover {
    color: var(--ink-primary);
    border-bottom-color: var(--ink-primary);
  }

  /* Recent essays grid */
  .recent__grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--sp-6);
    row-gap: 0;
  }

  @media (min-width: 640px) {
    .recent__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .recent__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Recent essays: never more than three rows at any breakpoint */
  .recent__grid > li:nth-child(n + 4) {
    display: none;
  }

  @media (min-width: 640px) {
    .recent__grid > li:nth-child(n + 4) {
      display: revert;
    }

    .recent__grid > li:nth-child(n + 7) {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .recent__grid > li:nth-child(n + 7) {
      display: revert;
    }
  }

  /* Books slider */
  .stacks__header-end {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }

  .stacks__controls {
    display: flex;
    gap: var(--sp-2);
  }

  .stacks__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule-hair);
    color: var(--ink-primary);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1;
    background: var(--bg-page);
    transition:
      color var(--t-base),
      border-color var(--t-base),
      opacity var(--t-base);
  }

  .stacks__arrow:hover:not(:disabled) {
    color: var(--accent-crimson);
    border-color: var(--accent-crimson);
  }

  .stacks__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .stacks__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--sp-5)) / 2);
    gap: var(--sp-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding-bottom: var(--sp-2);
  }

  .stacks__track::-webkit-scrollbar {
    display: none;
  }

  .stacks__slide {
    scroll-snap-align: start;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .stacks__track {
      grid-auto-columns: calc((100% - (var(--sp-5) * 2)) / 3);
    }
  }

  @media (min-width: 1024px) {
    .stacks__track {
      grid-auto-columns: calc((100% - (var(--sp-5) * 5)) / 6);
    }
  }

  .stacks {
    background: var(--bg-tinted);
    border-block: 1px solid var(--rule-hair);
  }

  .stacks__heading {
    color: var(--ink-primary);
  }

</style>
