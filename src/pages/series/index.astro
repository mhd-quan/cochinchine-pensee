---
/**
 * /series — Index of every essay series.
 *
 * A series is a fixed, ordered run of essays. No editorial preface:
 * the name, the count, and the essays themselves carry the page.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';

const series = await getCollection('series');

// Count only what a reader can actually open: announced-but-unpublished
// essays hold a slot inside a series, but don't count toward its total.
const published = await getCollection('essays', ({ data }) => !data.draft);
const publishedIds = new Set(published.map((e) => e.id));
const countFor = (ids: string[]) => ids.filter((id) => publishedIds.has(id)).length;
---

<BaseLayout
  title="Series"
  description="Các loạt tiểu luận của The Cochinchine Pensées: chủ nghĩa dân tộc, thế hệ kiệt sức, chủ nghĩa tư bản và kỷ nguyên vươn mình. Đọc theo từng chủ đề."
>
  <section class="series">
    <div class="container">
      <header class="series__header">
        <p class="series__eyebrow">Series</p>
        <h1 class="series__title">Series</h1>
      </header>

      <ul class="series__list">
        {series.map((entry) => (
          <li class="series__item">
            <a href={`/series/${entry.data.slug}`} class="series__link">
              <h2 class="series__name">
                {entry.data.nameVi ?? entry.data.name}
              </h2>
              {entry.data.name !== entry.data.nameVi && entry.data.nameVi && (
                <p class="series__name-en">{entry.data.name}</p>
              )}
              <p class="series__count">
                {(() => {
                  const n = countFor(entry.data.essayIds);
                  return `${n} ${n === 1 ? 'essay' : 'essays'}`;
                })()}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .series {
    padding-block: var(--sp-12) var(--sp-16);
  }

  .series__header {
    text-align: center;
    margin-bottom: var(--sp-10);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule-hair);
  }

  .series__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-3);
  }

  .series__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1.1;
    color: var(--ink-primary);
    margin-bottom: var(--sp-3);
  }

  .series__list {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--sp-8);
    row-gap: 0;
  }

  @media (min-width: 640px) {
    .series__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .series__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .series__item {
    border-top: 1px solid var(--ink-primary);
    padding-block: var(--sp-6);
  }

  .series__item:last-child {
    border-bottom: 1px solid var(--rule-hair);
  }

  .series__link {
    display: block;
    color: var(--ink-primary);
    transition: color var(--t-base);
  }

  .series__link:hover {
    color: var(--accent-crimson);
  }

  .series__name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-h2);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-2);
  }

  .series__name-en {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--sp-3);
  }

  .series__count {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .series__link:hover .series__count {
    color: var(--accent-crimson);
  }
</style>
