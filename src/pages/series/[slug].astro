---
/**
 * /series/[slug] — A single essay series.
 *
 * Renders the ordered run of essays. Publication state is per-essay: a
 * published essay gets a normal card, while one marked `draft` +
 * `comingSoon` keeps its place in the run as an inert slot. Drafts
 * without `comingSoon` are omitted entirely.
 */
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ComingSoonCard from '~/components/essay/ComingSoonCard.astro';
import EssayCard from '~/components/essay/EssayCard.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const allSeries = await getCollection('series');
  // Announced-but-unpublished essays are pulled in deliberately: their slot
  // is shown, their prose is not.
  const allEssays = await getCollection(
    'essays',
    ({ data }) => !data.draft || data.comingSoon,
  );
  const essaysById = new Map(allEssays.map((e) => [e.id, e]));

  return allSeries.map((entry) => {
    const essays = entry.data.essayIds
      .map((id) => essaysById.get(id))
      .filter((e): e is NonNullable<typeof e> => Boolean(e));

    return {
      params: { slug: entry.data.slug },
      props: { series: entry, essays },
    };
  });
}) satisfies GetStaticPaths;

const { series, essays } = Astro.props;
const publishedCount = essays.filter((e) => !e.data.draft).length;
---

<BaseLayout
  title={series.data.nameVi ?? series.data.name}
  description={series.data.description}
>
  <section class="series">
    <div class="container">
      <header class="series__header">
        <p class="series__eyebrow">Series</p>
        <h1 class="series__name">{series.data.nameVi ?? series.data.name}</h1>
        {series.data.nameVi && (
          <p class="series__name-en">{series.data.name}</p>
        )}
        <p class="series__count">
          {`${publishedCount} ${publishedCount === 1 ? 'essay' : 'essays'}`}
        </p>
      </header>

      {essays.length > 0 ? (
        <ul class="series__grid">
          {essays.map((essay) => (
            <li>
              {essay.data.draft ? (
                <ComingSoonCard essay={essay} />
              ) : (
                <EssayCard essay={essay} />
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="series__empty">No essays in this series yet.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .series {
    padding-block: var(--sp-12) var(--sp-16);
  }

  .series__header {
    text-align: center;
    margin-bottom: var(--sp-10);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule-hair);
  }

  .series__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-3);
  }

  .series__name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink-primary);
    margin-bottom: var(--sp-2);
  }

  .series__name-en {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-medium);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--sp-4);
  }

  .series__count {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .series__grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--sp-6);
    row-gap: 0;
  }

  @media (min-width: 640px) {
    .series__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .series__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .series__empty {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-muted);
    text-align: center;
    padding-block: var(--sp-12);
  }
</style>
