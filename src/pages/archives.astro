---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleList from '~/components/directory/ArticleList.astro';
import DirectoryLayout from '~/layouts/DirectoryLayout.astro';

const published = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const months = new Map<string, CollectionEntry<'essays'>[]>();
for (const entry of published) {
  const month = entry.data.date.toISOString().slice(0, 7);
  const entries = months.get(month) ?? [];
  entries.push(entry);
  months.set(month, entries);
}
const monthLabel = (month: string) => new Date(`${month}-01T00:00:00Z`)
  .toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<DirectoryLayout title="Archives" description="Tra cứu toàn bộ tiểu luận và pensées của The Cochinchine Pensées theo tháng và năm xuất bản.">
  <nav class="directory-jump" aria-label="Publication months">
    {[...months.keys()].map((month) => <a href={`#month-${month}`}>{monthLabel(month)}</a>)}
  </nav>
  {[...months].map(([month, entries]) => (
    <section id={`month-${month}`} aria-labelledby={`heading-${month}`}>
      <h2 id={`heading-${month}`}>{monthLabel(month)}</h2>
      <ArticleList entries={entries} />
    </section>
  ))}
</DirectoryLayout>
