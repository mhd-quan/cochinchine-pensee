---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SUBSTACK_SUBSCRIBE_URL } from '~/lib/newsletter';
---

<BaseLayout
  title="Subscribe"
  description="Đăng ký nhận tiểu luận tiếng Việt của The Cochinchine Pensées qua email mỗi tuần. Theo dõi bài viết mới và đọc các số trước trên Substack."
>
  <article class="subscribe">
    <div class="container">
      <header class="subscribe__header">
        <p class="subscribe__eyebrow">Newsletter</p>
        <h1 class="subscribe__title">Subscribe</h1>
        <p class="subscribe__intro">
          Weekly long-form Vietnamese essays, delivered directly to your inbox.
        </p>
      </header>

      <p class="subscribe__action">
        <a href={SUBSTACK_SUBSCRIBE_URL} class="subscribe__link subscribe__cta" rel="external">
          Open on Substack →
        </a>
      </p>

      <section class="subscribe__feeds" aria-labelledby="subscribe-feeds-title">
        <h2 id="subscribe-feeds-title" class="subscribe__feeds-title">Prefer a feed?</h2>
        <p class="subscribe__feeds-copy">
          Follow every new essay via{' '}
          <a href="/rss.xml" class="subscribe__link">RSS</a>,{' '}
          <a href="/feed.json" class="subscribe__link">JSON Feed</a>, or{' '}
          <a href="/" class="subscribe__link">return to the latest essay</a>.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .subscribe {
    padding-block: var(--sp-12) var(--sp-16);
  }

  .subscribe__header {
    max-width: var(--measure-prose);
    margin-inline: auto;
    text-align: center;
    margin-bottom: var(--sp-8);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule-hair);
  }

  .subscribe__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-3);
  }

  .subscribe__title {
    margin-bottom: var(--sp-4);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1.1;
    color: var(--ink-primary);
    text-wrap: balance;
  }

  .subscribe__intro {
    max-width: 32rem;
    margin-inline: auto;
    color: var(--ink-secondary);
    font-family: var(--font-serif);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  .subscribe__action {
    text-align: center;
  }

  .subscribe__cta {
    display: inline-block;
    padding-block: var(--sp-2);
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    line-height: 1.5;
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
  }

  .subscribe__feeds {
    max-width: var(--measure-prose);
    margin: var(--sp-10) auto 0;
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule-hair);
    text-align: center;
  }

  .subscribe__feeds-title {
    margin-bottom: var(--sp-2);
    color: var(--ink-primary);
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: var(--w-semibold);
    line-height: var(--lh-headline);
  }

  .subscribe__feeds-copy {
    color: var(--ink-secondary);
    font-family: var(--font-serif);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  .subscribe__link {
    color: var(--accent-crimson);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-skip-ink: auto;
    transition: color var(--t-fast);
  }

  .subscribe__link:hover {
    color: var(--ink-primary);
  }
</style>
