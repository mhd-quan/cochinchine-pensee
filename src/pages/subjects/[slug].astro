---
/**
 * /subjects/[slug] — Single subject page.
 * Renders the curated cluster of essays tagged with this subject.
 */
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import EssayCard from '~/components/essay/EssayCard.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const subjects = await getCollection('subjects');
  const allEssays = await getCollection('essays', ({ data }) => !data.draft);
  const essaysById = new Map(allEssays.map((e) => [e.id, e]));

  return subjects.map((subject) => {
    const essays = subject.data.essayIds
      .map((id) => essaysById.get(id))
      .filter((e): e is NonNullable<typeof e> => Boolean(e));

    return {
      params: { slug: subject.data.slug },
      props: { subject, essays },
    };
  });
}) satisfies GetStaticPaths;

const { subject, essays } = Astro.props;
---

<BaseLayout
  title={subject.data.nameVi ?? subject.data.name}
  description={subject.data.description}
>
  <section class="subject">
    <div class="container">
      <header class="subject__header">
        <p class="subject__eyebrow">Subject</p>
        <h1 class="subject__name">{subject.data.nameVi ?? subject.data.name}</h1>
        {subject.data.nameVi && (
          <p class="subject__name-en">{subject.data.name}</p>
        )}
        {subject.data.blurb && (
          <p class="subject__blurb">{subject.data.blurb}</p>
        )}
        <p class="subject__count">
          {essays.length} {essays.length === 1 ? 'essay' : 'essays'}
        </p>
      </header>

      {essays.length > 0 ? (
        <ul class="subject__grid">
          {essays.map((essay) => (
            <li>
              <EssayCard essay={essay} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="subject__empty">No essays in this subject yet.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .subject {
    padding-block: var(--sp-12) var(--sp-16);
  }

  .subject__header {
    text-align: center;
    margin-bottom: var(--sp-10);
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule-hair);
  }

  .subject__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-3);
  }

  .subject__name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink-primary);
    margin-bottom: var(--sp-2);
  }

  .subject__name-en {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-medium);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--sp-4);
  }

  .subject__blurb {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-body-larger);
    line-height: var(--lh-body-larger);
    color: var(--ink-secondary);
    max-width: 36rem;
    margin-inline: auto;
    margin-bottom: var(--sp-4);
  }

  .subject__count {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .subject__grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--sp-6);
    row-gap: 0;
  }

  @media (min-width: 640px) {
    .subject__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .subject__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .subject__empty {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-muted);
    text-align: center;
    padding-block: var(--sp-12);
  }
</style>
