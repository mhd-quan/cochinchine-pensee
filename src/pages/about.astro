---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="About The Cochinchine Pensées."
>
  <article class="about">
    <div class="container">
      <header class="about__header">
        <p class="about__eyebrow">About</p>
        <h1 class="about__title">About</h1>
        <p class="about__status" role="status">Under construction</p>
        <p class="about__asterism" aria-hidden="true">✦ ✦ ✦</p>
      </header>
    </div>
  </article>
</BaseLayout>

<style>
  .about {
    padding-block: var(--sp-12) var(--sp-16);
  }

  .about__header {
    text-align: center;
    padding-bottom: var(--sp-10);
  }

  .about__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
    margin-bottom: var(--sp-3);
  }

  .about__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1.1;
    color: var(--ink-primary);
  }

  .about__status {
    display: inline-block;
    margin-top: var(--sp-4);
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--accent-crimson);
    font-family: var(--font-sans);
    font-size: var(--fs-kicker);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-kicker);
    text-transform: uppercase;
    color: var(--accent-crimson);
  }

  .about__asterism {
    margin-top: var(--sp-10);
    font-family: var(--font-glyph);
    font-size: 0.875rem;
    letter-spacing: 1em;
    padding-left: 1em;
    color: var(--ink-muted);
  }
</style>
