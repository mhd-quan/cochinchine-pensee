---
import BaseLayout from '~/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="info-page container">
    <header class="info-page__header"><h1>{title}</h1></header>
    <div class="info-page__body" lang="vi"><slot /></div>
  </article>
</BaseLayout>

<style>
  .info-page {
    padding-block: var(--sp-12) var(--sp-10);
  }

  .info-page__header,
  .info-page__body {
    max-width: var(--measure-prose);
    margin-inline: auto;
  }

  .info-page__header {
    margin-bottom: var(--sp-10);
    text-align: center;
  }

  .info-page h1 {
    margin-bottom: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-headline);
  }

  .info-page__body {
    overflow-wrap: anywhere;
  }

  .info-page__body :global(a) {
    color: var(--accent-crimson);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .info-page__body :global(p) {
    margin-bottom: var(--sp-5);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  .info-page__body :global(section) {
    margin-top: var(--sp-8);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--rule-hair);
  }

  .info-page__body :global(h2) {
    margin-bottom: var(--sp-5);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: var(--lh-headline);
  }

  .info-page__body :global(.info-page__links) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
  }

  .info-page__body :global(.info-page__links a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-crimson);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
