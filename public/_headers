# Filenames change whenever the original image or encoding settings change.
/images/responsive/*
  Cache-Control: public, max-age=31536000, immutable

# Vite hashes these filenames when their contents change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Search entry points must revalidate when a new edition is deployed.
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate

# Reader downloads are image-only copies, not additional search landing pages.
/downloads/essays/*
  X-Robots-Tag: noindex, noarchive
  Content-Disposition: attachment
  Cache-Control: public, max-age=0, must-revalidate

# Discovery resource names hash their entire payload, including image metadata.
/discovery/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex
